---
import Layout from '../../layouts/Layout.astro';
import { getBeritaIndex } from '../../lib/berita-api';
import { BERITA_CONFIG, formatDateIndo, getCategoryIcon } from '../../lib/berita-config';

export const prerender = false;

const { posts, categories, isFallback } = await getBeritaIndex();

const publishedPosts = posts.filter((p) => p.status === 'published' || p.status === undefined);
const featuredPost = publishedPosts.find((p) => p.featured) || publishedPosts[0];
const regularPosts = publishedPosts.filter((p) => p.id !== featuredPost?.id);

const siteUrl = BERITA_CONFIG.siteUrl;
const canonicalUrl = `${siteUrl}/berita`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: BERITA_CONFIG.title,
  description: BERITA_CONFIG.description,
  url: canonicalUrl,
  publisher: {
    '@type': 'Organization',
    name: 'HIMTEKK Amikom Yogyakarta',
    url: siteUrl,
    logo: `${siteUrl}/assets/img/logo.webp`
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: publishedPosts.slice(0, 10).map((p, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      url: `${siteUrl}/berita/${p.slug}`,
      name: p.title
    }))
  }
};
---

<Layout
  title={BERITA_CONFIG.title}
  description={BERITA_CONFIG.description}
  canonical={canonicalUrl}
  keywords="Berita HIMTEKK, Pengumuman Amikom, Cyber Security Jogja, IoT Amikom, Kegiatan Teknik Komputer"
  bodyClass="text-slate-800 bg-slate-50 overflow-x-hidden"
  sweetalert={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <style is:inline>
      .berita-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .cat-pill.active {
        background-color: #00406E !important;
        color: #ffffff !important;
        border-color: #00406E !important;
      }
    </style>
  </Fragment>

  <!-- Navbar -->
  <nav id="navbar" class="fixed w-full z-50 transition-all duration-300 py-3 sm:py-4 bg-primary shadow-lg" data-solid="true">
    <div class="container mx-auto px-4 sm:px-6 flex justify-between items-center">
      <a href="/" class="flex items-center gap-2.5 sm:gap-3 group">
        <img src="/assets/img/logo.webp" alt="Logo HIMTEKK" class="nav-logo-img transition-transform group-hover:rotate-12" width="40" height="40" decoding="async">
        <span class="text-xl sm:text-2xl font-bold text-white"><span class="text-accent">HIM</span>TEKK</span>
      </a>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn" class="md:hidden text-white p-2 focus:outline-none" aria-label="Toggle menu navigasi">
        <i class="fas fa-bars text-xl sm:text-2xl"></i>
      </button>

      <!-- Desktop Links -->
      <ul class="hidden md:flex space-x-7 text-white font-medium items-center">
        <li><a href="/#hero" class="nav-link">Home</a></li>
        <li><a href="/#about" class="nav-link">Tentang</a></li>
        <li><a href="/#fokus" class="nav-link">Fokus</a></li>
        <li><a href="/pages/pengurus" class="nav-link">Pengurus</a></li>
        <li><a href="/pages/divisi" class="nav-link">Divisi</a></li>
        <li><a href="/berita" class="nav-link active text-accent font-semibold">Berita</a></li>
        <li><a href="/#contact" class="nav-link">Kontak</a></li>
      </ul>
    </div>

    <!-- Mobile Menu Dropdown -->
    <div id="mobile-menu" class="hidden md:hidden bg-primary text-white px-6 py-4 absolute w-full left-0 animate__animated animate__fadeInDown shadow-2xl border-t border-white/10">
      <ul class="flex flex-col space-y-3 font-medium text-sm">
        <li><a href="/#hero" class="block py-1 hover:text-accent">Home</a></li>
        <li><a href="/#about" class="block py-1 hover:text-accent">Tentang</a></li>
        <li><a href="/#fokus" class="block py-1 hover:text-accent">Fokus</a></li>
        <li><a href="/pages/pengurus" class="block py-1 hover:text-accent">Pengurus</a></li>
        <li><a href="/pages/divisi" class="block py-1 hover:text-accent">Divisi</a></li>
        <li><a href="/berita" class="block py-1 text-accent font-bold">Berita</a></li>
        <li><a href="/#contact" class="block py-1 hover:text-accent">Kontak</a></li>
      </ul>
    </div>
  </nav>

  <!-- Header Hero Section -->
  <header class="pt-28 pb-16 sm:pt-36 sm:pb-20 bg-hero-pattern bg-cover md:bg-fixed bg-center relative overflow-hidden">
    <div class="absolute inset-0 bg-primary/80 backdrop-blur-[2px]"></div>

    <div class="container mx-auto px-4 sm:px-6 relative z-10 text-center">
      <!-- Breadcrumbs -->
      <nav class="flex justify-center items-center gap-2 text-white/70 text-xs sm:text-sm mb-6 animate__animated animate__fadeInDown" aria-label="Breadcrumb">
        <a href="/" class="hover:text-accent transition-colors">Home</a>
        <i class="fas fa-chevron-right text-[10px]"></i>
        <span class="text-white font-medium">Berita & Informasi</span>
      </nav>

      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-accent/20 backdrop-blur-md border border-accent/40 rounded-full text-accent text-xs font-bold uppercase tracking-widest mb-5 animate__animated animate__zoomIn">
        <i class="fas fa-newspaper"></i> Portal Informasi Resmi
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-white mb-4 sm:mb-6 tracking-tight animate__animated animate__fadeInUp">
        Kabar & Wawasan <span class="text-accent underline decoration-accent/40 underline-offset-8">HIMTEKK</span>
      </h1>

      <p class="text-sm sm:text-base md:text-lg text-secondary/90 max-w-2xl mx-auto leading-relaxed animate__animated animate__fadeInUp animate__delay-1s">
        Pusat publikasi agenda kegiatan keorganisasian, pengumuman akademik resmi, edukasi Cyber Security, serta inovasi Internet of Things Universitas Amikom Yogyakarta.
      </p>

      {isFallback && (
        <div class="mt-6 max-w-xl mx-auto p-3 bg-amber-500/20 border border-amber-400/40 rounded-xl text-amber-200 text-xs text-left flex items-start gap-3">
          <i class="fas fa-info-circle text-amber-300 text-base mt-0.5 shrink-0"></i>
          <div>
            <strong>Mode Pratinjau Database:</strong> Google Apps Script belum terhubung ke environment Vercel. Data contoh bawaan ditampilkan sementara. Silakan hubungkan Google Sheets melalui panduan di file <code class="bg-black/30 px-1 py-0.5 rounded">google-apps-script/berita/README.md</code>.
          </div>
        </div>
      )}
    </div>
  </header>

  <!-- Main Content Area -->
  <main class="py-12 sm:py-16">
    <div class="container mx-auto px-4 sm:px-6">

      <!-- Featured Article (Hero Card) -->
      {featuredPost && (
        <section class="mb-14" data-aos="fade-up">
          <div class="relative bg-white rounded-3xl shadow-xl border border-slate-200/80 overflow-hidden hover:shadow-2xl transition-all duration-300 group">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
              <!-- Thumbnail -->
              <div class="lg:col-span-7 relative overflow-hidden aspect-[16/9] lg:aspect-auto min-h-[260px] sm:min-h-[360px]">
                <img
                  src={featuredPost.thumbnail || '/assets/img/hero.webp'}
                  alt={featuredPost.title}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="eager"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  onerror="this.onerror=null;this.src='/assets/img/hero.webp';"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent lg:hidden"></div>
                <div class="absolute top-4 left-4 z-10">
                  <span class="berita-badge bg-accent text-slate-900 shadow-md">
                    <i class="fas fa-star text-[10px]"></i> Berita Utama
                  </span>
                </div>
              </div>

              <!-- Content Info -->
              <div class="lg:col-span-5 p-6 sm:p-8 md:p-10 flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-3 text-xs text-slate-500 mb-3">
                    <span class="berita-badge bg-primary/10 text-primary">
                      <i class={`fas ${getCategoryIcon(featuredPost.category)}`}></i>
                      {featuredPost.category_name || featuredPost.category}
                    </span>
                    <span>•</span>
                    <span class="flex items-center gap-1.5">
                      <i class="far fa-calendar-alt text-slate-400"></i>
                      {formatDateIndo(featuredPost.published_at || featuredPost.created_at)}
                    </span>
                  </div>

                  <h2 class="text-2xl sm:text-3xl font-extrabold text-primary mb-4 leading-tight group-hover:text-accent transition-colors">
                    <a href={`/berita/${featuredPost.slug}`}>
                      {featuredPost.title}
                    </a>
                  </h2>

                  <p class="text-slate-600 text-sm sm:text-base leading-relaxed line-clamp-3 mb-6">
                    {featuredPost.excerpt}
                  </p>
                </div>

                <div class="pt-6 border-t border-slate-100 flex items-center justify-between">
                  <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-xs">
                      <i class="fas fa-user-edit"></i>
                    </div>
                    <span class="text-xs font-semibold text-slate-700">{featuredPost.author_name}</span>
                  </div>

                  <a
                    href={`/berita/${featuredPost.slug}`}
                    class="inline-flex items-center gap-2 text-sm font-bold text-primary group-hover:text-accent group-hover:translate-x-1 transition-all"
                  >
                    Baca Selengkapnya <i class="fas fa-arrow-right text-xs"></i>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- Filter Kategori & Search Bar -->
      <section class="mb-10" data-aos="fade-up">
        <div class="flex flex-col lg:flex-row gap-4 justify-between items-stretch lg:items-center bg-white p-4 sm:p-5 rounded-2xl shadow-sm border border-slate-200">
          
          <!-- Category Pills -->
          <div class="flex items-center gap-2 overflow-x-auto pb-2 lg:pb-0 scrollbar-none" id="categoryFilterContainer">
            <button
              type="button"
              data-cat="all"
              class="cat-pill active px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold border border-slate-200 whitespace-nowrap transition-all shadow-sm bg-primary text-white"
            >
              Semua ({publishedPosts.length})
            </button>
            {categories.map((c) => (
              <button
                type="button"
                data-cat={c.slug}
                class="cat-pill px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold border border-slate-200 text-slate-700 bg-slate-50 hover:bg-slate-100 whitespace-nowrap transition-all"
              >
                <i class={`fas ${getCategoryIcon(c.slug)} text-[11px] mr-1 opacity-70`}></i>
                {c.name} ({c.count})
              </button>
            ))}
          </div>

          <!-- Live Search Input -->
          <div class="relative min-w-[260px] sm:min-w-[300px]">
            <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
            <input
              type="text"
              id="searchBeritaInput"
              placeholder="Cari berita atau pengumuman..."
              class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-xs sm:text-sm transition-all bg-slate-50 focus:bg-white"
            />
          </div>
        </div>
      </section>

      <!-- Post Grid Section -->
      <section>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8" id="beritaGrid">
          {regularPosts.map((post) => (
            <article
              class="berita-card bg-white rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden group"
              data-category={post.category}
              data-title={post.title.toLowerCase()}
              data-excerpt={post.excerpt.toLowerCase()}
              data-tags={(post.tags || []).join(' ').toLowerCase()}
              data-aos="fade-up"
            >
              <!-- Thumbnail -->
              <a href={`/berita/${post.slug}`} class="block relative aspect-[16/9] overflow-hidden bg-slate-100">
                <img
                  src={post.thumbnail || '/assets/img/placeholder.webp'}
                  alt={post.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  onerror="this.onerror=null;this.src='/assets/img/placeholder.webp';"
                />
                <div class="absolute top-3 left-3">
                  <span class="berita-badge bg-primary text-white shadow">
                    <i class={`fas ${getCategoryIcon(post.category)}`}></i>
                    {post.category_name || post.category}
                  </span>
                </div>
              </a>

              <!-- Card Body -->
              <div class="p-6 flex flex-col flex-grow justify-between">
                <div>
                  <div class="flex items-center gap-3 text-xs text-slate-400 mb-3">
                    <span class="flex items-center gap-1.5">
                      <i class="far fa-calendar-alt"></i>
                      {formatDateIndo(post.published_at || post.created_at)}
                    </span>
                    <span>•</span>
                    <span class="flex items-center gap-1">
                      <i class="far fa-eye"></i> {post.views || 0}
                    </span>
                  </div>

                  <h3 class="text-lg font-bold text-slate-900 group-hover:text-primary transition-colors leading-snug mb-3">
                    <a href={`/berita/${post.slug}`} class="line-clamp-2">
                      {post.title}
                    </a>
                  </h3>

                  <p class="text-xs sm:text-sm text-slate-600 line-clamp-3 leading-relaxed mb-4">
                    {post.excerpt}
                  </p>
                </div>

                <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
                  <span class="font-medium text-slate-500 flex items-center gap-1.5">
                    <i class="far fa-user text-slate-400"></i> {post.author_name}
                  </span>
                  <a
                    href={`/berita/${post.slug}`}
                    class="font-bold text-primary group-hover:text-accent inline-flex items-center gap-1 transition-colors"
                  >
                    Baca <i class="fas fa-chevron-right text-[10px]"></i>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <!-- Empty State -->
        <div id="beritaEmptyState" class="hidden py-16 text-center">
          <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center text-slate-400 text-2xl mx-auto mb-4">
            <i class="fas fa-newspaper"></i>
          </div>
          <h3 class="text-lg font-bold text-slate-800 mb-1">Tidak Ada Berita Ditemukan</h3>
          <p class="text-sm text-slate-500 max-w-sm mx-auto mb-6">
            Coba ubah kata kunci pencarian Anda atau pilih kategori berita lainnya.
          </p>
          <button
            type="button"
            id="resetBeritaFilterBtn"
            class="px-4 py-2 bg-primary text-white text-xs font-semibold rounded-xl hover:bg-primary/90 transition-all"
          >
            Tampilkan Semua Berita
          </button>
        </div>
      </section>

    </div>
  </main>

  <!-- Footer -->
  <footer class="pt-20 pb-10 bg-slate-900 text-white border-t border-white/5">
    <div class="container mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
        <div>
          <div class="flex items-center gap-3 mb-6">
            <img src="/assets/img/logo.webp" alt="Logo HIMTEKK" class="h-12 w-auto" width="48" height="48" loading="lazy" decoding="async">
            <span class="text-2xl font-bold"><span class="text-accent">HIM</span>TEKK</span>
          </div>
          <p class="text-slate-400 leading-relaxed mb-6 text-sm">
            Himpunan Mahasiswa Teknik Komputer Universitas Amikom Yogyakarta. Wadah pengembangan diri di bidang Cyber Security dan IoT.
          </p>
        </div>
        <div>
          <h4 class="text-lg font-bold mb-6 text-accent uppercase tracking-wider">Navigasi</h4>
          <ul class="space-y-4 text-slate-400 text-sm">
            <li><a href="/#hero" class="hover:text-accent transition-colors">Home</a></li>
            <li><a href="/pages/pengurus" class="hover:text-accent transition-colors">Struktur Pengurus</a></li>
            <li><a href="/pages/divisi" class="hover:text-accent transition-colors">Informasi Divisi</a></li>
            <li><a href="/berita" class="hover:text-accent transition-colors">Kabar Berita</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-lg font-bold mb-6 text-accent uppercase tracking-wider">Kontak</h4>
          <ul class="space-y-3 text-slate-400 text-sm">
            <li class="flex items-center gap-3">
              <i class="fas fa-envelope text-accent"></i>
              <span>himtekk@amikom.ac.id</span>
            </li>
            <li class="flex items-start gap-3">
              <i class="fas fa-map-marker-alt text-accent mt-1"></i>
              <span>Gedung BSC Lantai 3, Universitas Amikom Yogyakarta</span>
            </li>
          </ul>
        </div>
        <div>
          <h4 class="text-lg font-bold mb-6 text-accent uppercase tracking-wider">Media Sosial</h4>
          <p class="text-slate-400 text-sm mb-4">Ikuti saluran informasi resmi HIMTEKK untuk agenda kegiatan, seminar teknologi, dan kabar akademik terbaru.</p>
          <div class="flex items-center gap-2.5">
            <a
              href="https://www.instagram.com/himtekk_amikom/"
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-lg bg-white/10 hover:bg-accent hover:text-slate-900 text-white flex items-center justify-center transition-all"
              title="Instagram @himtekk_amikom"
            >
              <i class="fab fa-instagram text-base"></i>
            </a>
            <a
              href="https://www.linkedin.com/company/himtekk-amikom/"
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-lg bg-white/10 hover:bg-accent hover:text-slate-900 text-white flex items-center justify-center transition-all"
              title="LinkedIn HIMTEKK"
            >
              <i class="fab fa-linkedin-in text-base"></i>
            </a>
            <a
              href="https://github.com/himtekk"
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-lg bg-white/10 hover:bg-accent hover:text-slate-900 text-white flex items-center justify-center transition-all"
              title="GitHub HIMTEKK"
            >
              <i class="fab fa-github text-base"></i>
            </a>
          </div>
        </div>
      </div>
      <div class="pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4 text-slate-500 text-sm">
        <p>&copy; 2026 HIMTEKK Universitas Amikom Yogyakarta. All rights reserved.</p>
        <div class="flex gap-6">
          <a href="/pages/privacy" class="hover:text-accent transition-colors">Privacy Policy</a>
          <a href="/pages/terms" class="hover:text-accent transition-colors">Terms of Service</a>
        </div>
      </div>
    </div>
  </footer>

  <Fragment slot="scripts">
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const catButtons = document.querySelectorAll('.cat-pill');
        const cards = document.querySelectorAll('.berita-card');
        const searchInput = document.getElementById('searchBeritaInput');
        const emptyState = document.getElementById('beritaEmptyState');
        const resetBtn = document.getElementById('resetBeritaFilterBtn');

        let activeCategory = 'all';
        let searchQuery = '';

        function applyFilters() {
          let visibleCount = 0;

          cards.forEach((card) => {
            const cardCat = card.getAttribute('data-category') || '';
            const cardTitle = card.getAttribute('data-title') || '';
            const cardExcerpt = card.getAttribute('data-excerpt') || '';
            const cardTags = card.getAttribute('data-tags') || '';

            const matchesCat = activeCategory === 'all' || cardCat === activeCategory;
            const matchesSearch =
              !searchQuery ||
              cardTitle.includes(searchQuery) ||
              cardExcerpt.includes(searchQuery) ||
              cardTags.includes(searchQuery);

            if (matchesCat && matchesSearch) {
              card.style.display = 'flex';
              visibleCount++;
            } else {
              card.style.display = 'none';
            }
          });

          if (emptyState) {
            emptyState.classList.toggle('hidden', visibleCount > 0);
          }
        }

        catButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            catButtons.forEach((b) => {
              b.classList.remove('active', 'bg-primary', 'text-white');
              b.classList.add('bg-slate-50', 'text-slate-700');
            });
            btn.classList.add('active', 'bg-primary', 'text-white');
            btn.classList.remove('bg-slate-50', 'text-slate-700');

            activeCategory = btn.getAttribute('data-cat') || 'all';
            applyFilters();
          });
        });

        if (searchInput) {
          searchInput.addEventListener('input', (e) => {
            searchQuery = e.target.value.toLowerCase().trim();
            applyFilters();
          });
        }

        if (resetBtn) {
          resetBtn.addEventListener('click', () => {
            activeCategory = 'all';
            searchQuery = '';
            if (searchInput) searchInput.value = '';
            catButtons.forEach((b) => {
              if (b.getAttribute('data-cat') === 'all') {
                b.classList.add('active', 'bg-primary', 'text-white');
                b.classList.remove('bg-slate-50', 'text-slate-700');
              } else {
                b.classList.remove('active', 'bg-primary', 'text-white');
                b.classList.add('bg-slate-50', 'text-slate-700');
              }
            });
            applyFilters();
          });
        }
      });
    </script>
  </Fragment>
</Layout>
