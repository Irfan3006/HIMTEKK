---
import Layout from '../../../layouts/Layout.astro';
import { BERITA_CONFIG } from '../../../lib/berita-config';

export const prerender = false;
---

<Layout
  title="Edit Berita - Dashboard HIMTEKK"
  description="Edit dan perbarui konten berita HIMTEKK Amikom."
  canonical={`${BERITA_CONFIG.siteUrl}/berita/admin/edit`}
  robots="noindex, nofollow"
  bodyClass="text-slate-800 bg-slate-100 min-h-screen"
  sweetalert={true}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/css/easymde.min.css?v=2.21.0">
    <script is:inline src="/js/easymde.min.js?v=2.21.0"></script>
    <script is:inline src="/js/marked.min.js?v=18.2.0"></script>
    <style is:inline>
      .EasyMDEContainer {
        border-radius: 0.75rem;
        border: 1px solid #E2E8F0;
        overflow: hidden;
        background: #FFFFFF;
        transition: border-color 0.2s, box-shadow 0.2s;
      }
      .EasyMDEContainer:focus-within {
        border-color: #00406E;
        box-shadow: 0 0 0 3px rgba(0, 64, 110, 0.15);
      }
      .editor-toolbar {
        background: #F8FAFC !important;
        border: none !important;
        border-bottom: 1px solid #E2E8F0 !important;
        padding: 6px 8px !important;
        opacity: 1 !important;
      }
      .editor-toolbar button {
        color: #334155 !important;
        border-radius: 0.5rem !important;
        width: 32px !important;
        height: 32px !important;
        margin: 1px 2px !important;
        transition: all 0.15s ease !important;
        border: 1px solid transparent !important;
      }
      .editor-toolbar button:hover {
        background: #E2E8F0 !important;
        color: #00406E !important;
      }
      .editor-toolbar button.active {
        background: #E2E8F0 !important;
        color: #00406E !important;
        border-color: #CBD5E1 !important;
      }
      .editor-toolbar button i {
        font-size: 13px !important;
      }
      .editor-toolbar i.separator {
        border-left: 1px solid #E2E8F0 !important;
        border-right: none !important;
        margin: 0 6px !important;
      }
      .CodeMirror {
        border: none !important;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
        font-size: 0.95rem !important;
        line-height: 1.6 !important;
        padding: 10px 14px !important;
        color: #1E293B !important;
        background: #FFFFFF !important;
      }
      .CodeMirror-cursor {
        border-left: 2px solid #00406E !important;
      }
      .editor-statusbar {
        padding: 6px 12px !important;
        font-size: 0.75rem !important;
        color: #64748B !important;
        background: #F8FAFC !important;
        border-top: 1px solid #F1F5F9 !important;
      }
      .EasyMDEContainer.fullscreen {
        z-index: 99999 !important;
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        border-radius: 0 !important;
      }
      .editor-toolbar.fullscreen {
        z-index: 99999 !important;
      }
      .editor-preview, .editor-preview-side {
        background: #FFFFFF !important;
        padding: 1.5rem !important;
        color: #1E293B !important;
      }
    </style>
  </Fragment>

  <!-- Admin Top Bar -->
  <header class="bg-primary text-white shadow-md sticky top-0 z-40">
    <div class="container mx-auto px-4 sm:px-6 py-3.5 flex justify-between items-center">
      <div class="flex items-center gap-3">
        <a href="/berita/admin" class="flex items-center gap-2 group text-white/80 hover:text-white transition-colors">
          <i class="fas fa-arrow-left text-sm"></i>
          <span class="text-xs sm:text-sm font-semibold">Kembali ke Dashboard</span>
        </a>
      </div>

      <div class="flex items-center gap-2">
        <a
          id="previewPostLink"
          href="#"
          target="_blank"
          class="hidden px-3 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 text-xs font-semibold text-white transition-all items-center gap-1.5"
        >
          <i class="fas fa-eye text-[10px]"></i> Lihat Berita
        </a>
      </div>
    </div>
  </header>

  <main class="container mx-auto px-4 sm:px-6 py-8 max-w-5xl">
    <!-- Loading skeleton -->
    <div id="loadingBox" class="bg-white rounded-3xl p-10 text-center border border-slate-200 shadow-sm">
      <i class="fas fa-circle-notch fa-spin text-2xl text-primary mb-3"></i>
      <p class="text-sm text-slate-500 font-semibold">Memuat data berita dari database...</p>
    </div>

    <!-- Edit Form Container -->
    <div id="editFormContainer" class="hidden bg-white rounded-3xl p-6 sm:p-8 md:p-10 border border-slate-200 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-8 pb-4 border-b border-slate-100">
        <div>
          <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900">Perbarui Berita</h1>
          <p class="text-xs sm:text-sm text-slate-500">Edit isi tulisan, kategori, atau status publikasi berita ini.</p>
        </div>
      </div>

      <form id="editPostForm" novalidate>
        <!-- Judul Berita -->
        <div class="mb-5">
          <label for="postTitleInput" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
            Judul Berita <span class="text-rose-500">*</span>
          </label>
          <input
            type="text"
            id="postTitleInput"
            required
            class="w-full text-base sm:text-lg font-bold p-3.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
          />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
          <!-- Kategori -->
          <div>
            <label for="postCategorySelect" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
              Kategori <span class="text-rose-500">*</span>
            </label>
            <select
              id="postCategorySelect"
              required
              class="w-full text-sm p-3 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all font-semibold"
            >
              <option value="" disabled>Pilih Kategori...</option>
            </select>
          </div>

          <!-- Tags -->
          <div>
            <label for="postTagsInput" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
              Topik / Tags <span class="text-slate-400 font-normal text-[11px]">(Pisahkan dengan koma)</span>
            </label>
            <input
              type="text"
              id="postTagsInput"
              class="w-full text-sm p-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
            />
          </div>
        </div>

        <!-- Thumbnail Image -->
        <div class="mb-5 p-4 rounded-2xl bg-slate-50 border border-slate-200">
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
            Gambar Sampul (Thumbnail)
          </label>

          <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center mb-3">
            <div class="relative flex-grow">
              <input
                type="url"
                id="postThumbnailUrlInput"
                class="w-full text-xs sm:text-sm p-2.5 rounded-xl border border-slate-200 bg-white focus:outline-none focus:ring-1 focus:ring-primary"
              />
            </div>
            <div class="flex items-center gap-2">
              <label class="px-3.5 py-2.5 bg-white border border-slate-300 hover:bg-slate-100 text-slate-700 text-xs font-bold rounded-xl cursor-pointer flex items-center gap-1.5 transition-all shrink-0">
                <i class="fas fa-cloud-arrow-up text-primary"></i>
                <span id="uploadLabelText">Unggah Berkas</span>
                <input type="file" id="postThumbnailFileInput" accept="image/webp,image/jpeg,image/png,image/gif" class="hidden">
              </label>
            </div>
          </div>

          <!-- Preview Thumbnail -->
          <div id="thumbnailPreviewContainer" class="hidden items-center gap-3 pt-2 border-t border-slate-200/60">
            <img id="thumbnailPreviewImg" src="" alt="Pratinjau" class="w-20 h-12 object-cover rounded-lg border border-slate-300">
            <span class="text-xs text-slate-500 font-medium">Pratinjau gambar sampul</span>
          </div>
        </div>

        <!-- Excerpt -->
        <div class="mb-5">
          <label for="postExcerptInput" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
            Ringkasan Singkat (Excerpt)
          </label>
          <textarea
            id="postExcerptInput"
            rows="2"
            maxlength="280"
            class="w-full text-xs sm:text-sm p-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
          ></textarea>
        </div>

        <!-- Markdown Content Editor -->
        <div class="mb-6">
          <div class="flex justify-between items-center mb-2">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">
              Isi Konten Berita (Markdown) <span class="text-rose-500">*</span>
            </label>
            <span id="contentCharCounter" class="text-xs text-slate-400 font-medium">0 kata</span>
          </div>
          <textarea
            id="markdownEditor"
            rows="12"
            placeholder="Tuliskan isi berita Anda di sini dengan format Markdown..."
            class="w-full text-sm font-mono p-4 rounded-2xl border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-slate-800"
          ></textarea>
          <div class="text-[11px] text-slate-400 mt-1.5 flex items-center gap-1.5">
            <i class="fas fa-circle-info text-primary"></i>
            <span>Mendukung format Markdown (# Judul, **tebal**, _miring_, - list, > kutipan, dan ```code```).</span>
          </div>
        </div>

        <!-- Post Options -->
        <div class="mb-8 p-4 rounded-2xl bg-slate-50 border border-slate-200 flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-6">
            <label class="inline-flex items-center gap-2 cursor-pointer">
              <input type="checkbox" id="postFeaturedCheckbox" class="w-4 h-4 text-primary rounded border-slate-300 focus:ring-primary">
              <span class="text-xs font-bold text-slate-700 flex items-center gap-1">
                <i class="fas fa-star text-amber-500 text-xs"></i> Jadikan Berita Utama (Featured)
              </span>
            </label>
          </div>

          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-slate-600">Status Publikasi:</span>
            <select id="postStatusSelect" class="text-xs font-bold p-2 rounded-xl border border-slate-200 bg-white focus:outline-none focus:ring-1 focus:ring-primary">
              <option value="published">Diterbitkan (Published)</option>
              <option value="draft">Draft (Belum Ditampilkan)</option>
            </select>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center justify-end gap-3 pt-4 border-t border-slate-100">
          <a
            href="/berita/admin"
            class="px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs sm:text-sm transition-all"
          >
            Batal
          </a>

          <button
            type="submit"
            id="savePostBtn"
            class="px-6 py-2.5 rounded-xl bg-primary hover:bg-primary/95 text-white font-bold text-xs sm:text-sm transition-all shadow-md flex items-center gap-2 cursor-pointer"
          >
            <i class="fas fa-check text-xs" id="saveIcon"></i>
            <span id="saveText">Simpan Perubahan</span>
          </button>
        </div>

      </form>
    </div>
  </main>

  <Fragment slot="scripts">
    <script is:inline src="/js/berita.js"></script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', async () => {
        if (typeof BeritaAuth === 'undefined' || !BeritaAuth.requireAuth()) return;

        const params = new URLSearchParams(window.location.search);
        const postId = params.get('id');

        if (!postId) {
          window.location.href = '/berita/admin';
          return;
        }

        const catSelect = document.getElementById('postCategorySelect');
        const titleInput = document.getElementById('postTitleInput');
        const tagsInput = document.getElementById('postTagsInput');
        const thumbInput = document.getElementById('postThumbnailUrlInput');
        const excerptInput = document.getElementById('postExcerptInput');
        const featuredCheckbox = document.getElementById('postFeaturedCheckbox');
        const statusSelect = document.getElementById('postStatusSelect');
        const prevBox = document.getElementById('thumbnailPreviewContainer');
        const prevImg = document.getElementById('thumbnailPreviewImg');
        const previewLink = document.getElementById('previewPostLink');

        function updateThumbPreview(url) {
          if (url && url.startsWith('http')) {
            prevImg.src = url;
            prevBox.classList.remove('hidden');
            prevBox.classList.add('flex');
          } else {
            prevBox.classList.add('hidden');
            prevBox.classList.remove('flex');
          }
        }
        thumbInput.addEventListener('input', (e) => updateThumbPreview(e.target.value.trim()));

        // Inisialisasi categories
        try {
          const catRes = await BeritaAPI.getCategories();
          if (catRes.success && catRes.data && Array.isArray(catRes.data.categories)) {
            catRes.data.categories.forEach((c) => {
              const opt = document.createElement('option');
              opt.value = c.slug;
              opt.textContent = `${c.name} (${c.slug})`;
              catSelect.appendChild(opt);
            });
          }
        } catch (_) {}

        let easymde = null;
        const textareaEl = document.getElementById('markdownEditor');
        const counter = document.getElementById('contentCharCounter');

        function updateWordCount(text) {
          const val = (text || '').trim();
          const words = val ? val.split(/\s+/).filter(Boolean).length : 0;
          if (counter) counter.textContent = `${words} kata (~${Math.max(1, Math.ceil(words / 200))} mnt baca)`;
        }

        // Load data post
        const res = await BeritaAPI.getPost(postId);
        if (res.success && res.data) {
          const post = res.data;

          document.getElementById('loadingBox').classList.add('hidden');
          document.getElementById('editFormContainer').classList.remove('hidden');

          titleInput.value = post.title || '';
          catSelect.value = post.category || '';
          tagsInput.value = (post.tags || []).join(', ');
          thumbInput.value = post.thumbnail || '';
          excerptInput.value = post.excerpt || '';
          featuredCheckbox.checked = Boolean(post.featured);
          statusSelect.value = post.status || 'published';
          updateThumbPreview(post.thumbnail);

          if (previewLink) {
            previewLink.href = `/berita/${post.slug}`;
            previewLink.classList.remove('hidden');
            previewLink.classList.add('inline-flex');
          }

          if (textareaEl) {
            textareaEl.value = post.content || '';
          }

          if (typeof EasyMDE !== 'undefined' && textareaEl) {
            easymde = new EasyMDE({
              element: textareaEl,
              spellChecker: false,
              minHeight: '380px',
              placeholder: 'Tuliskan isi berita Anda di sini dengan format Markdown...',
              status: ['lines', 'words', 'cursor'],
              previewRender: function (plainText) {
                if (typeof marked !== 'undefined' && marked.parse) {
                  return marked.parse(plainText);
                }
                return plainText;
              },
              toolbar: [
                { name: 'bold', action: EasyMDE.toggleBold, className: 'fa-solid fa-bold', title: 'Tebal (Ctrl+B)' },
                { name: 'italic', action: EasyMDE.toggleItalic, className: 'fa-solid fa-italic', title: 'Miring (Ctrl+I)' },
                { name: 'heading', action: EasyMDE.toggleHeadingSmaller, className: 'fa-solid fa-heading', title: 'Judul / Heading (Ctrl+H)' },
                '|',
                { name: 'quote', action: EasyMDE.toggleBlockquote, className: 'fa-solid fa-quote-left', title: 'Kutipan (Ctrl+\')' },
                { name: 'unordered-list', action: EasyMDE.toggleUnorderedList, className: 'fa-solid fa-list-ul', title: 'Daftar Poin (Ctrl+L)' },
                { name: 'ordered-list', action: EasyMDE.toggleOrderedList, className: 'fa-solid fa-list-ol', title: 'Daftar Angka (Ctrl+Alt+L)' },
                { name: 'code', action: EasyMDE.toggleCodeBlock, className: 'fa-solid fa-code', title: 'Blok Kode' },
                '|',
                { name: 'link', action: EasyMDE.drawLink, className: 'fa-solid fa-link', title: 'Sisipkan Tautan (Ctrl+K)' },
                { name: 'image', action: EasyMDE.drawImage, className: 'fa-solid fa-image', title: 'Sisipkan Gambar (Ctrl+Alt+I)' },
                { name: 'table', action: EasyMDE.drawTable, className: 'fa-solid fa-table', title: 'Sisipkan Tabel' },
                '|',
                { name: 'preview', action: EasyMDE.togglePreview, className: 'fa-solid fa-eye no-disable', title: 'Pratinjau Hasil' },
                { name: 'side-by-side', action: EasyMDE.toggleSideBySide, className: 'fa-solid fa-table-columns no-disable no-mobile', title: 'Berdampingan (Side-by-side)' },
                { name: 'fullscreen', action: EasyMDE.toggleFullScreen, className: 'fa-solid fa-expand no-disable no-mobile', title: 'Layar Penuh' },
                '|',
                { name: 'undo', action: EasyMDE.undo, className: 'fa-solid fa-rotate-left no-disable', title: 'Urungkan (Ctrl+Z)' },
                { name: 'redo', action: EasyMDE.redo, className: 'fa-solid fa-rotate-right no-disable', title: 'Ulangi (Ctrl+Y)' },
                '|',
                {
                  name: 'guide',
                  action: 'https://www.markdownguide.org/basic-syntax/',
                  className: 'fa-solid fa-circle-question',
                  title: 'Panduan Format Markdown'
                }
              ]
            });

            easymde.value(post.content || '');
            easymde.codemirror.on('change', () => {
              updateWordCount(easymde.value());
            });
            setTimeout(() => {
              easymde.codemirror.refresh();
            }, 50);
            updateWordCount(post.content || '');
          } else if (textareaEl) {
            textareaEl.addEventListener('input', () => {
              updateWordCount(textareaEl.value);
            });
            updateWordCount(post.content || '');
          }
        } else {
          Swal.fire({
            title: 'Berita Tidak Ditemukan',
            text: res.message || 'Data berita gagal dimuat dari server.',
            icon: 'error',
            confirmButtonColor: '#00406E'
          }).then(() => {
            window.location.href = '/berita/admin';
          });
          return;
        }

        // Upload berkas lokal ke Google Drive
        const fileInput = document.getElementById('postThumbnailFileInput');
        const uploadLabel = document.getElementById('uploadLabelText');
        fileInput.addEventListener('change', async (e) => {
          const file = e.target.files[0];
          if (!file) return;

          if (file.size > 3 * 1024 * 1024) {
            showBeritaToast('error', 'Berkas Terlalu Besar', 'Maksimal ukuran gambar adalah 3 MB.');
            return;
          }

          uploadLabel.textContent = 'Mengunggah...';
          const reader = new FileReader();
          reader.onload = async () => {
            const base64 = reader.result;
            const upRes = await BeritaAPI.uploadImage(base64, file.name);
            uploadLabel.textContent = 'Unggah Berkas';

            if (upRes.success && upRes.data && upRes.data.url) {
              thumbInput.value = upRes.data.url;
              updateThumbPreview(upRes.data.url);
              showBeritaToast('success', 'Gambar Berhasil Diunggah');
            } else {
              showBeritaToast('error', 'Gagal Mengunggah', upRes.message);
            }
          };
          reader.readAsDataURL(file);
        });

        // Submit Update Form
        const form = document.getElementById('editPostForm');
        const saveBtn = document.getElementById('savePostBtn');
        const saveText = document.getElementById('saveText');
        const saveIcon = document.getElementById('saveIcon');

        form.addEventListener('submit', async (e) => {
          e.preventDefault();

          const title = titleInput.value.trim();
          const category = catSelect.value;
          const tags = tagsInput.value.trim();
          const thumbnail = thumbInput.value.trim();
          const excerpt = excerptInput.value.trim();
          const featured = featuredCheckbox.checked;
          const status = statusSelect.value;
          const content = easymde ? easymde.value().trim() : (document.getElementById('markdownEditor')?.value || '').trim();

          if (!title || !category || !content) {
            showBeritaToast('error', 'Validasi Gagal', 'Harap lengkapi judul, kategori, dan isi berita.');
            return;
          }

          saveBtn.disabled = true;
          saveText.textContent = 'Menyimpan...';
          saveIcon.className = 'fas fa-spinner fa-spin text-xs';

          const saveRes = await BeritaAPI.savePost({
            id: postId,
            title,
            category,
            tags,
            thumbnail,
            excerpt,
            featured,
            status,
            content
          });

          saveBtn.disabled = false;
          saveText.textContent = 'Simpan Perubahan';
          saveIcon.className = 'fas fa-check text-xs';

          if (saveRes.success && saveRes.data) {
            Swal.fire({
              title: 'Perubahan Disimpan!',
              text: 'Berita telah berhasil diperbarui di database.',
              icon: 'success',
              confirmButtonColor: '#00406E'
            }).then(() => {
              window.location.href = `/berita/${saveRes.data.slug}`;
            });
          } else {
            showBeritaToast('error', 'Gagal Menyimpan', saveRes.message);
          }
        });
      });
    </script>
  </Fragment>
</Layout>
