---
import Layout from '../../layouts/Layout.astro';
import { getBeritaBySlug, getBeritaIndex } from '../../lib/berita-api';
import { BERITA_CONFIG, formatDateIndo, formatDateTimeIndo, getCategoryIcon } from '../../lib/berita-config';
import { marked } from 'marked';

function sanitizeArticleHtml(html: string): string {
  if (!html) return '';
  return html
    .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
    .replace(/<iframe\b[^<]*(?:(?!<\/iframe>)<[^<]*)*<\/iframe>/gi, '')
    .replace(/<object\b[^<]*(?:(?!<\/object>)<[^<]*)*<\/object>/gi, '')
    .replace(/<embed\b[^<]*(?:(?!<\/embed>)<[^<]*)*<\/embed>/gi, '')
    .replace(/\son\w+\s*=\s*(['"]).*?\1/gi, '')
    .replace(/\son\w+\s*=\s*[^>\s]+/gi, '')
    .replace(/href\s*=\s*(['"])javascript:.*?\1/gi, 'href="#"');
}

export const prerender = false;
export const maxDuration = 60;

const { slug } = Astro.params;

// Jalankan fetch post detail dan index secara paralel untuk performa optimal
const [postResult, indexData] = await Promise.all([
  slug ? getBeritaBySlug(slug as string) : Promise.resolve({ post: null, status: 'NOT_FOUND' as const }),
  getBeritaIndex().catch(() => ({ posts: [], categories: [] }))
]);

const post = postResult.post;

if (!post) {
  Astro.response.status = 404;
}

const tags = post ? (
  Array.isArray(post.tags)
    ? post.tags
    : typeof post.tags === 'string' && post.tags
      ? (post.tags as string).split(',').map((t) => t.trim()).filter(Boolean)
      : []
) : [];

// Render markdown to sanitized HTML
let safeContent = '';
if (post) {
  try {
    const rawHtml = await marked.parse(post.content || post.excerpt || '');
    safeContent = sanitizeArticleHtml(String(rawHtml || ''));
  } catch (_) {
    safeContent = `<p>${post.excerpt || post.title}</p>`;
  }
}

const wordCount = post ? (post.word_count || (post.content || '').split(/\s+/).filter(Boolean).length) : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// Rekomendasi berita terkait
const relatedPosts = post
  ? (indexData?.posts || [])
      .filter((p) => p.slug !== post.slug)
      .slice(0, 3)
  : [];

const siteUrl = BERITA_CONFIG.siteUrl;
const postUrl = post ? `${siteUrl}/berita/${post.slug}` : `${siteUrl}/berita`;
const postThumbnail = post && post.thumbnail && post.thumbnail.startsWith('http')
  ? post.thumbnail
  : `${siteUrl}${post?.thumbnail || '/assets/img/og.webp'}`;

const jsonLd = post ? {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: post.title,
  description: post.excerpt,
  image: [postThumbnail],
  datePublished: post.published_at || post.created_at,
  dateModified: post.updated_at || post.published_at || post.created_at,
  author: {
    '@type': 'Person',
    name: post.author_name,
    jobTitle: 'Kontributor Berita HIMTEKK'
  },
  publisher: {
    '@type': 'Organization',
    name: 'HIMTEKK Amikom Yogyakarta',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/assets/img/logo.webp`
    }
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl
  }
} : null;
---

{!post ? (
  <Layout
    title="Berita Tidak Ditemukan - HIMTEKK"
    description="Berita yang Anda cari tidak ditemukan atau telah dipindahkan."
    robots="noindex, follow"
    bodyClass="text-slate-800 bg-slate-50 min-h-screen flex flex-col justify-between"
    sweetalert={false}
  >
    <nav class="w-full py-2.5 sm:py-3 bg-primary shadow-md">
      <div class="container mx-auto px-4 sm:px-6 flex justify-between items-center">
        <a href="/" class="flex items-center gap-2">
          <img src="/assets/img/logo.webp" alt="Logo HIMTEKK" class="w-8 h-8" width="32" height="32" decoding="async">
          <span class="text-lg sm:text-xl font-bold text-white"><span class="text-accent">HIM</span>TEKK</span>
        </a>
        <a href="/berita" class="px-3 py-1 rounded-md bg-white/10 hover:bg-accent hover:text-slate-900 text-xs font-semibold text-white transition-all flex items-center gap-1.5">
          <i class="fas fa-arrow-left text-[10px]"></i> Kembali ke Berita
        </a>
      </div>
    </nav>

    <main class="container mx-auto px-4 py-16 text-center my-auto max-w-lg">
      <div class="w-20 h-20 mx-auto mb-6 rounded-3xl bg-amber-100 text-amber-600 flex items-center justify-center text-3xl shadow-sm">
        <i class="fas fa-file-circle-xmark"></i>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-3">Berita Tidak Ditemukan</h1>
      <p class="text-sm sm:text-base text-slate-600 mb-8 leading-relaxed">
        Artikel berita yang Anda tuju mungkin belum dipublikasikan, tautannya salah, atau telah dipindahkan.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="/berita" class="px-6 py-3 rounded-full bg-primary hover:bg-primary/90 text-white font-bold text-sm shadow-md transition-all flex items-center gap-2">
          <i class="fas fa-newspaper"></i> Jelajahi Berita Lain
        </a>
        <a href="/" class="px-6 py-3 rounded-full bg-white border border-slate-300 hover:bg-slate-100 text-slate-700 font-bold text-sm transition-all">
          Ke Beranda
        </a>
      </div>
    </main>

    <footer class="py-6 text-center text-xs text-slate-400 border-t border-slate-200">
      &copy; 2026 HIMTEKK Universitas Amikom Yogyakarta
    </footer>
  </Layout>
) : (
<Layout
  title={`${post.title} - HIMTEKK`}
  description={post.excerpt}
  canonical={postUrl}
  ogTitle={post.title}
  ogDescription={post.excerpt}
  bodyClass="text-slate-900 bg-white overflow-x-hidden font-sans"
  sweetalert={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <meta property="article:published_time" content={post.published_at || post.created_at} />
    <meta property="article:section" content={post.category_name || post.category} />
    {tags.map((t) => <meta property="article:tag" content={t} />)}

    <style is:inline>
      /* Reading Progress Bar */
      #readingProgressBar {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        background: #00406E;
        width: 0%;
        z-index: 9999;
        transition: width 0.1s ease-out;
      }

      /* Article Editorial Content Styling */
      .article-content {
        font-size: 1.1rem;
        line-height: 1.85;
        color: #1e293b;
      }
      .article-content p {
        margin-bottom: 1.5rem;
      }
      .article-content h2 {
        font-size: 1.5rem;
        font-weight: 800;
        color: #0f172a;
        margin-top: 2.25rem;
        margin-bottom: 0.85rem;
        line-height: 1.35;
      }
      .article-content h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: #0f172a;
        margin-top: 1.75rem;
        margin-bottom: 0.65rem;
        line-height: 1.4;
      }
      .article-content ul, .article-content ol {
        margin-left: 1.5rem;
        margin-bottom: 1.5rem;
      }
      .article-content ul {
        list-style-type: disc;
      }
      .article-content ol {
        list-style-type: decimal;
      }
      .article-content li {
        margin-bottom: 0.5rem;
        padding-left: 0.25rem;
      }
      .article-content blockquote {
        border-left: 4px solid #00406E;
        background: #F8FAFC;
        padding: 1rem 1.25rem;
        margin: 1.75rem 0;
        font-style: italic;
        color: #334155;
        border-radius: 2px;
      }
      .article-content pre {
        background: #0F172A;
        color: #E2E8F0;
        padding: 1.15rem;
        border-radius: 6px;
        overflow-x: auto;
        margin: 1.5rem 0;
        font-size: 0.9rem;
      }
      .article-content code {
        background: #F1F5F9;
        color: #00406E;
        padding: 0.15rem 0.35rem;
        border-radius: 3px;
        font-size: 0.88em;
      }
      .article-content pre code {
        background: transparent;
        color: inherit;
        padding: 0;
      }
      .article-content img {
        margin: 1.75rem auto;
        border-radius: 4px;
        max-width: 100%;
        height: auto;
      }
      .article-content a {
        color: #00406E;
        text-decoration: underline;
        font-weight: 600;
      }
      .article-content a:hover {
        color: #DBB865;
      }
      .article-content table {
        width: 100%;
        margin: 1.5rem 0;
        border-collapse: collapse;
      }
      .article-content th, .article-content td {
        border: 1px solid #E2E8F0;
        padding: 0.65rem 0.85rem;
        text-align: left;
      }
      .article-content th {
        background: #F8FAFC;
        font-weight: 700;
        color: #0f172a;
      }
    </style>
  </Fragment>

  <!-- Reading Progress Bar -->
  <div id="readingProgressBar"></div>

  <!-- Navbar -->
  <nav id="navbar" class="fixed w-full z-50 transition-all duration-200 py-2.5 sm:py-3 bg-primary shadow-sm" data-solid="true">
    <div class="container mx-auto px-4 sm:px-6 flex justify-between items-center max-w-5xl">
      <a href="/" class="flex items-center gap-2 group">
        <img src="/assets/img/logo.webp" alt="Logo HIMTEKK" class="w-8 h-8 transition-transform group-hover:rotate-12" width="32" height="32" decoding="async">
        <span class="text-lg sm:text-xl font-bold tracking-tight text-white"><span class="text-accent">HIM</span>TEKK</span>
      </a>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn" class="md:hidden text-white p-1.5 focus:outline-none rounded hover:bg-white/10" aria-label="Toggle menu navigasi">
        <i class="fas fa-bars text-lg"></i>
      </button>

      <!-- Desktop Links -->
      <ul class="hidden md:flex space-x-6 text-white text-sm font-medium items-center">
        <li><a href="/#hero" class="nav-link hover:text-accent transition-colors">Home</a></li>
        <li><a href="/pages/pengurus" class="nav-link hover:text-accent transition-colors">Pengurus</a></li>
        <li><a href="/pages/divisi" class="nav-link hover:text-accent transition-colors">Divisi</a></li>
        <li><a href="/berita" class="nav-link active text-accent font-semibold">Berita</a></li>
        <li><a href="/#contact" class="nav-link hover:text-accent transition-colors">Kontak</a></li>
        <li>
          <a href="/berita" class="ml-2 px-2.5 py-1 rounded-md bg-white/10 hover:bg-accent hover:text-slate-900 text-xs font-semibold tracking-wide transition-all border border-white/20 flex items-center gap-1.5">
            <i class="fas fa-arrow-left text-[10px]"></i> Semua Berita
          </a>
        </li>
      </ul>
    </div>

    <!-- Mobile Menu Dropdown -->
    <div id="mobile-menu" class="hidden md:hidden bg-primary text-white px-5 py-3 absolute w-full left-0 animate__animated animate__fadeInDown shadow-2xl border-t border-white/10">
      <ul class="flex flex-col space-y-2.5 font-medium text-sm">
        <li><a href="/#hero" class="block py-1 hover:text-accent">Home</a></li>
        <li><a href="/pages/pengurus" class="block py-1 hover:text-accent">Pengurus</a></li>
        <li><a href="/pages/divisi" class="block py-1 hover:text-accent">Divisi</a></li>
        <li><a href="/berita" class="block py-1 text-accent font-bold">Semua Berita</a></li>
        <li><a href="/#contact" class="block py-1 hover:text-accent">Kontak</a></li>
      </ul>
    </div>
  </nav>

  <!-- Main Article Body (Clean White Editorial Layout ala CNN Indonesia) -->
  <main class="pt-20 sm:pt-24 pb-16 bg-white min-h-screen">
    <article class="max-w-[760px] mx-auto px-4 sm:px-6">

      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-3" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <span class="text-slate-300">/</span>
        <a href="/berita" class="hover:text-primary transition-colors">Berita</a>
        <span class="text-slate-300">/</span>
        <span class="text-red-700 font-semibold">{post.category_name || post.category}</span>
      </nav>

      <!-- Judul Artikel -->
      <h1 class="text-2xl sm:text-3xl md:text-[34px] font-extrabold text-slate-900 leading-[1.28] tracking-tight mb-3">
        {post.title}
      </h1>

      <!-- Sumber / Redaksi & Kategori -->
      <div class="flex items-center gap-2 text-sm sm:text-base font-bold text-red-700 mb-1">
        <span>{post.author_name || 'HIMTEKK Amikom'}</span>
        <span class="text-slate-300 font-normal">·</span>
        <span class="text-slate-600 font-semibold text-xs sm:text-sm uppercase tracking-wider">{post.category_name || post.category}</span>
      </div>

      <!-- Tanggal & Info Baca -->
      <div class="text-xs sm:text-sm text-slate-500 mb-4 flex flex-wrap items-center gap-x-2 gap-y-1">
        <time datetime={post.published_at || post.created_at}>
          {formatDateTimeIndo(post.published_at || post.created_at)}
        </time>
        <span class="text-slate-300">·</span>
        <span>~{readingTime} menit baca</span>
        <span class="text-slate-300">·</span>
        <span id="postViewsDisplay"><span id="postViewsCount">{post.views || 0}</span> dibaca</span>
      </div>

      <!-- Baris Bagikan (Share Bar ala CNN) -->
      <div class="flex items-center justify-between py-3 border-y border-slate-200 mb-6">
        <div class="flex items-center gap-2.5 sm:gap-3">
          <span class="text-xs sm:text-sm font-medium text-slate-700 mr-1">Bagikan:</span>
          <!-- WhatsApp -->
          <a
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`${post.title} - Baca selengkapnya di: ${postUrl}`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-8 h-8 rounded-full bg-[#25D366] text-white flex items-center justify-center hover:opacity-90 transition-opacity shadow-xs"
            title="Bagikan ke WhatsApp"
          >
            <i class="fab fa-whatsapp text-sm"></i>
          </a>

          <!-- Facebook -->
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(postUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-8 h-8 rounded-full bg-[#1877F2] text-white flex items-center justify-center hover:opacity-90 transition-opacity shadow-xs"
            title="Bagikan ke Facebook"
          >
            <i class="fab fa-facebook-f text-sm"></i>
          </a>

          <!-- X / Twitter -->
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(postUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-8 h-8 rounded-full bg-black text-white flex items-center justify-center hover:opacity-90 transition-opacity shadow-xs"
            title="Bagikan ke X (Twitter)"
          >
            <i class="fab fa-x-twitter text-sm"></i>
          </a>

          <!-- Salin Link -->
          <button
            type="button"
            id="copyPostLinkBtn"
            class="w-8 h-8 rounded-full bg-slate-500 hover:bg-slate-600 text-white flex items-center justify-center transition-colors shadow-xs"
            title="Salin Tautan Berita"
          >
            <i class="fas fa-link text-xs"></i>
          </button>
        </div>

        <!-- Bookmark / Simpan -->
        <button
          type="button"
          id="bookmarkBtn"
          class="p-1.5 text-slate-400 hover:text-primary transition-colors"
          title="Simpan artikel"
        >
          <i class="far fa-bookmark text-base"></i>
        </button>
      </div>

      <!-- Foto Utama & Caption -->
      {post.thumbnail && (
        <figure class="mb-6">
          <div class="w-full aspect-[16/9] sm:aspect-[16/10] overflow-hidden bg-slate-100 rounded-sm">
            <img
              src={post.thumbnail}
              alt={post.title}
              class="w-full h-full object-cover"
              loading="eager"
              decoding="async"
            />
          </div>
          <figcaption class="mt-2 text-xs text-slate-500 italic">
            (Foto: HIMTEKK / Dokumentasi Kegiatan).
          </figcaption>
        </figure>
      )}

      <!-- Isi Artikel (Editorial Text Flow) -->
      <div class="article-content" set:html={safeContent} />

      <!-- Topik Terkait (Tags) -->
      {tags.length > 0 && (
        <div class="mt-10 pt-6 border-t border-slate-200">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">
            Topik Terkait:
          </div>
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-medium rounded transition-colors">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- Bottom Share Bar -->
      <div class="mt-8 py-3.5 border-y border-slate-200 flex items-center justify-between">
        <span class="text-xs sm:text-sm font-semibold text-slate-700">Bagikan artikel ini:</span>
        <div class="flex items-center gap-2">
          <a
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`${post.title} - ${postUrl}`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-7 h-7 rounded-full bg-[#25D366] text-white flex items-center justify-center hover:opacity-90 text-xs"
            title="WhatsApp"
          >
            <i class="fab fa-whatsapp"></i>
          </a>
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(postUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-7 h-7 rounded-full bg-[#1877F2] text-white flex items-center justify-center hover:opacity-90 text-xs"
            title="Facebook"
          >
            <i class="fab fa-facebook-f"></i>
          </a>
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(postUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-7 h-7 rounded-full bg-black text-white flex items-center justify-center hover:opacity-90 text-xs"
            title="X"
          >
            <i class="fab fa-x-twitter"></i>
          </a>
        </div>
      </div>

      <!-- Kotak Redaksi / Penulis -->
      <div class="mt-8 p-5 bg-slate-50 border border-slate-200 rounded-lg flex items-start gap-4">
        <div class="w-12 h-12 rounded-full bg-primary/10 text-primary flex items-center justify-center text-xl shrink-0">
          <i class="fas fa-shield-halved"></i>
        </div>
        <div>
          <div class="text-[11px] font-bold uppercase tracking-wider text-primary mb-0.5">Redaksi HIMTEKK</div>
          <h3 class="font-bold text-slate-900 text-sm">{post.author_name}</h3>
          <p class="text-xs text-slate-600 mt-1 leading-relaxed">
            Himpunan Mahasiswa Teknik Komputer (HIMTEKK) Universitas Amikom Yogyakarta berfokus pada pengembangan riset Cyber Security, Internet of Things (IoT), dan kontribusi kemajuan teknologi mahasiswa.
          </p>
        </div>
      </div>

      <!-- Berita Terkait (Clean Editorial Grid) -->
      {relatedPosts.length > 0 && (
        <section class="mt-12 pt-8 border-t border-slate-200">
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg sm:text-xl font-bold text-slate-900">Berita Terkait</h3>
            <a href="/berita" class="text-xs font-semibold text-primary hover:underline flex items-center gap-1">
              Lihat Semua <i class="fas fa-arrow-right text-[10px]"></i>
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
            {relatedPosts.map((rel) => (
              <a href={`/berita/${rel.slug}`} class="group flex flex-col">
                <div class="aspect-[16/10] overflow-hidden bg-slate-100 rounded-sm mb-2.5">
                  <img
                    src={rel.thumbnail || '/assets/img/placeholder.webp'}
                    alt={rel.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
                <span class="text-[11px] font-bold uppercase text-red-700 mb-1">
                  {rel.category_name || rel.category}
                </span>
                <h4 class="font-bold text-sm text-slate-900 group-hover:text-primary transition-colors line-clamp-2 leading-snug mb-2">
                  {rel.title}
                </h4>
                <div class="text-[11px] text-slate-400 mt-auto">
                  {formatDateIndo(rel.published_at || rel.created_at)}
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </article>
  </main>

  <!-- Footer -->
  <footer class="pt-20 pb-10 bg-slate-900 text-white border-t border-white/5">
    <div class="container mx-auto px-6 text-center">
      <div class="flex items-center justify-center gap-3 mb-4">
        <img src="/assets/img/logo.webp" alt="Logo HIMTEKK" class="h-10 w-auto" width="40" height="40" loading="lazy">
        <span class="text-xl font-bold"><span class="text-accent">HIM</span>TEKK</span>
      </div>
      <p class="text-slate-400 text-xs sm:text-sm mb-6 max-w-md mx-auto">
        Portal Berita & Publikasi Resmi Himpunan Mahasiswa Teknik Komputer Universitas Amikom Yogyakarta.
      </p>
      <div class="flex justify-center gap-6 text-xs text-slate-500">
        <a href="/" class="hover:text-accent">Beranda</a>
        <a href="/berita" class="hover:text-accent">Daftar Berita</a>
        <a href="/pages/privacy" class="hover:text-accent">Privacy Policy</a>
        <a href="/pages/terms" class="hover:text-accent">Terms</a>
      </div>
      <p class="text-slate-600 text-xs mt-6">&copy; 2026 HIMTEKK Amikom. All rights reserved.</p>
    </div>
  </footer>

  <Fragment slot="scripts">
    <script is:inline src="/js/berita.js"></script>
    <script is:inline define:vars={{ postSlug: post.slug }}>
      document.addEventListener('DOMContentLoaded', () => {
        // 1. Reading progress bar
        const progressBar = document.getElementById('readingProgressBar');
        window.addEventListener('scroll', () => {
          const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          if (docHeight > 0) {
            const scrolled = (window.scrollY / docHeight) * 100;
            if (progressBar) progressBar.style.width = `${scrolled}%`;
          }
        }, { passive: true });

        // 2. Increment view counter via client-side gateway
        if (typeof BeritaAPI !== 'undefined' && postSlug) {
          BeritaAPI.incrementView(postSlug).then((res) => {
            if (res && res.success && res.data && typeof res.data.views === 'number') {
              const el = document.getElementById('postViewsCount');
              if (el) el.textContent = res.data.views;
            }
          }).catch(() => {});
        }

        // 3. Salin link tombol
        const copyBtn = document.getElementById('copyPostLinkBtn');
        if (copyBtn) {
          copyBtn.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(window.location.href);
              if (typeof showBeritaToast === 'function') {
                showBeritaToast('success', 'Tautan Berhasil Disalin', 'Tautan artikel telah tersimpan di clipboard Anda.');
              } else {
                alert('Tautan artikel telah disalin.');
              }
            } catch {
              alert('Gagal menyalin tautan.');
            }
          });
        }

        // 4. Bookmark button toggle
        const bookmarkBtn = document.getElementById('bookmarkBtn');
        if (bookmarkBtn) {
          bookmarkBtn.addEventListener('click', () => {
            const icon = bookmarkBtn.querySelector('i');
            if (icon) {
              const isSaved = icon.classList.contains('fas');
              if (isSaved) {
                icon.className = 'far fa-bookmark text-base';
                if (typeof showBeritaToast === 'function') {
                  showBeritaToast('info', 'Dihapus', 'Artikel dihapus dari simpanan.');
                }
              } else {
                icon.className = 'fas fa-bookmark text-base text-amber-500';
                if (typeof showBeritaToast === 'function') {
                  showBeritaToast('success', 'Disimpan', 'Artikel berhasil disimpan.');
                }
              }
            }
          });
        }
      });
    </script>
  </Fragment>
</Layout>
)}
