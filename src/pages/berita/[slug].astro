---
import Layout from '../../layouts/Layout.astro';
import { getBeritaBySlug, getBeritaIndex } from '../../lib/berita-api';
import { BERITA_CONFIG, formatDateIndo, formatDateTimeIndo, getCategoryIcon } from '../../lib/berita-config';
import { marked } from 'marked';

function sanitizeArticleHtml(html: string): string {
  if (!html) return '';
  return html
    .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
    .replace(/<iframe\b[^<]*(?:(?!<\/iframe>)<[^<]*)*<\/iframe>/gi, '')
    .replace(/<object\b[^<]*(?:(?!<\/object>)<[^<]*)*<\/object>/gi, '')
    .replace(/<embed\b[^<]*(?:(?!<\/embed>)<[^<]*)*<\/embed>/gi, '')
    .replace(/\son\w+\s*=\s*(['"]).*?\1/gi, '')
    .replace(/\son\w+\s*=\s*[^>\s]+/gi, '')
    .replace(/href\s*=\s*(['"])javascript:.*?\1/gi, 'href="#"');
}

export const prerender = false;
export const maxDuration = 60;

const { slug } = Astro.params;

// Jalankan fetch post detail dan index secara paralel untuk performa optimal
const [postResult, indexData] = await Promise.all([
  slug ? getBeritaBySlug(slug as string) : Promise.resolve({ post: null, status: 'NOT_FOUND' as const }),
  getBeritaIndex().catch(() => ({ posts: [], categories: [] }))
]);

const post = postResult.post;

if (!post) {
  Astro.response.status = 404;
}

const tags = post ? (
  Array.isArray(post.tags)
    ? post.tags
    : typeof post.tags === 'string' && post.tags
      ? (post.tags as string).split(',').map((t) => t.trim()).filter(Boolean)
      : []
) : [];

// Render markdown to sanitized HTML
let safeContent = '';
if (post) {
  try {
    const rawHtml = await marked.parse(post.content || post.excerpt || '');
    safeContent = sanitizeArticleHtml(String(rawHtml || ''));
  } catch (_) {
    safeContent = `<p>${post.excerpt || post.title}</p>`;
  }
}

const wordCount = post ? (post.word_count || (post.content || '').split(/\s+/).filter(Boolean).length) : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// Rekomendasi berita terkait
const relatedPosts = post
  ? (indexData?.posts || [])
      .filter((p) => p.slug !== post.slug)
      .slice(0, 3)
  : [];

const siteUrl = BERITA_CONFIG.siteUrl;
const postUrl = post ? `${siteUrl}/berita/${post.slug}` : `${siteUrl}/berita`;
const postThumbnail = post && post.thumbnail && post.thumbnail.startsWith('http')
  ? post.thumbnail
  : `${siteUrl}${post?.thumbnail || '/assets/img/og.webp'}`;

const jsonLd = post ? {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: post.title,
  description: post.excerpt,
  image: [postThumbnail],
  datePublished: post.published_at || post.created_at,
  dateModified: post.updated_at || post.published_at || post.created_at,
  author: {
    '@type': 'Person',
    name: post.author_name,
    jobTitle: 'Kontributor Berita HIMTEKK'
  },
  publisher: {
    '@type': 'Organization',
    name: 'HIMTEKK Amikom Yogyakarta',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/assets/img/logo.webp`
    }
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl
  }
} : null;
---

{!post ? (
  <Layout
    title="Berita Tidak Ditemukan - HIMTEKK"
    description="Berita yang Anda cari tidak ditemukan atau telah dipindahkan."
    robots="noindex, follow"
    bodyClass="text-slate-800 bg-slate-50 min-h-screen flex flex-col justify-between"
    sweetalert={false}
  >
    <nav class="w-full py-2.5 sm:py-3 bg-primary shadow-md">
      <div class="container mx-auto px-4 sm:px-6 flex justify-between items-center">
        <a href="/" class="flex items-center gap-2">
          <img src="/assets/img/logo.webp" alt="Logo HIMTEKK" class="w-8 h-8" width="32" height="32" decoding="async">
          <span class="text-lg sm:text-xl font-bold text-white"><span class="text-accent">HIM</span>TEKK</span>
        </a>
        <a href="/berita" class="px-3 py-1 rounded-md bg-white/10 hover:bg-accent hover:text-slate-900 text-xs font-semibold text-white transition-all flex items-center gap-1.5">
          <i class="fas fa-arrow-left text-[10px]"></i> Kembali ke Berita
        </a>
      </div>
    </nav>

    <main class="container mx-auto px-4 py-16 text-center my-auto max-w-lg">
      <div class="w-20 h-20 mx-auto mb-6 rounded-3xl bg-amber-100 text-amber-600 flex items-center justify-center text-3xl shadow-sm">
        <i class="fas fa-file-circle-xmark"></i>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-3">Berita Tidak Ditemukan</h1>
      <p class="text-sm sm:text-base text-slate-600 mb-8 leading-relaxed">
        Artikel berita yang Anda tuju mungkin belum dipublikasikan, tautannya salah, atau telah dipindahkan.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="/berita" class="px-6 py-3 rounded-full bg-primary hover:bg-primary/90 text-white font-bold text-sm shadow-md transition-all flex items-center gap-2">
          <i class="fas fa-newspaper"></i> Jelajahi Berita Lain
        </a>
        <a href="/" class="px-6 py-3 rounded-full bg-white border border-slate-300 hover:bg-slate-100 text-slate-700 font-bold text-sm transition-all">
          Ke Beranda
        </a>
      </div>
    </main>

    <footer class="py-6 text-center text-xs text-slate-400 border-t border-slate-200">
      &copy; 2026 HIMTEKK Universitas Amikom Yogyakarta
    </footer>
  </Layout>
) : (
<Layout
  title={`${post.title} - HIMTEKK`}
  description={post.excerpt}
  canonical={postUrl}
  ogTitle={post.title}
  ogDescription={post.excerpt}
  bodyClass="text-slate-800 bg-slate-50 overflow-x-hidden"
  sweetalert={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <meta property="article:published_time" content={post.published_at || post.created_at} />
    <meta property="article:section" content={post.category_name || post.category} />
    {tags.map((t) => <meta property="article:tag" content={t} />)}

    <style is:inline>
      /* Reading Progress Bar */
      #readingProgressBar {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        background: #DBB865;
        width: 0%;
        z-index: 9999;
        transition: width 0.1s ease-out;
      }

      /* Article Markdown Content Styling */
      .article-content {
        font-size: 1.05rem;
        line-height: 1.8;
        color: #334155;
      }
      .article-content h2 {
        font-size: 1.5rem;
        font-weight: 700;
        color: #00406E;
        margin-top: 2rem;
        margin-bottom: 0.85rem;
        line-height: 1.3;
        border-bottom: 1px solid #E2E8F0;
        padding-bottom: 0.4rem;
      }
      .article-content h3 {
        font-size: 1.25rem;
        font-weight: 600;
        color: #00406E;
        margin-top: 1.5rem;
        margin-bottom: 0.65rem;
        line-height: 1.4;
      }
      .article-content p {
        margin-bottom: 1.25rem;
      }
      .article-content ul, .article-content ol {
        margin-left: 1.35rem;
        margin-bottom: 1.25rem;
      }
      .article-content ul {
        list-style-type: disc;
      }
      .article-content ol {
        list-style-type: decimal;
      }
      .article-content li {
        margin-bottom: 0.4rem;
      }
      .article-content blockquote {
        border-left: 3px solid #DBB865;
        background: rgba(219, 184, 101, 0.07);
        padding: 0.85rem 1.15rem;
        border-radius: 0 6px 6px 0;
        margin: 1.35rem 0;
        font-style: italic;
        color: #1E293B;
      }
      .article-content pre {
        background: #0F172A;
        color: #E2E8F0;
        padding: 1.15rem;
        border-radius: 10px;
        overflow-x: auto;
        margin: 1.35rem 0;
        font-size: 0.9rem;
      }
      .article-content code {
        background: #F1F5F9;
        color: #00406E;
        padding: 0.15rem 0.35rem;
        border-radius: 4px;
        font-size: 0.88em;
      }
      .article-content pre code {
        background: transparent;
        color: inherit;
        padding: 0;
      }
      .article-content img {
        border-radius: 14px;
        margin: 1.5rem auto;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
      }
      .article-content a {
        color: #00406E;
        text-decoration: underline;
        font-weight: 600;
      }
      .article-content a:hover {
        color: #DBB865;
      }
      .article-content table {
        width: 100%;
        margin: 1.35rem 0;
        border-collapse: collapse;
      }
      .article-content th, .article-content td {
        border: 1px solid #E2E8F0;
        padding: 0.65rem 0.85rem;
        text-align: left;
      }
      .article-content th {
        background: #F8FAFC;
        font-weight: 700;
        color: #00406E;
      }
    </style>
  </Fragment>

  <!-- Reading Progress Bar -->
  <div id="readingProgressBar"></div>

  <!-- Navbar (Sleek & Compact for News Portal) -->
  <nav id="navbar" class="fixed w-full z-50 transition-all duration-200 py-2 sm:py-2.5 bg-primary shadow-md" data-solid="true">
    <div class="container mx-auto px-4 sm:px-6 flex justify-between items-center">
      <a href="/" class="flex items-center gap-2 group">
        <img src="/assets/img/logo.webp" alt="Logo HIMTEKK" class="w-8 h-8 transition-transform group-hover:rotate-12" width="32" height="32" decoding="async">
        <span class="text-lg sm:text-xl font-bold tracking-tight text-white"><span class="text-accent">HIM</span>TEKK</span>
      </a>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn" class="md:hidden text-white p-1.5 focus:outline-none rounded hover:bg-white/10" aria-label="Toggle menu navigasi">
        <i class="fas fa-bars text-lg"></i>
      </button>

      <!-- Desktop Links -->
      <ul class="hidden md:flex space-x-6 text-white text-sm font-medium items-center">
        <li><a href="/#hero" class="nav-link hover:text-accent transition-colors">Home</a></li>
        <li><a href="/pages/pengurus" class="nav-link hover:text-accent transition-colors">Pengurus</a></li>
        <li><a href="/pages/divisi" class="nav-link hover:text-accent transition-colors">Divisi</a></li>
        <li><a href="/berita" class="nav-link active text-accent font-semibold">Berita</a></li>
        <li><a href="/#contact" class="nav-link hover:text-accent transition-colors">Kontak</a></li>
        <li>
          <a href="/berita" class="ml-2 px-2.5 py-1 rounded-md bg-white/10 hover:bg-accent hover:text-slate-900 text-xs font-semibold tracking-wide transition-all border border-white/20 flex items-center gap-1.5">
            <i class="fas fa-arrow-left text-[10px]"></i> Semua Berita
          </a>
        </li>
      </ul>
    </div>

    <!-- Mobile Menu Dropdown -->
    <div id="mobile-menu" class="hidden md:hidden bg-primary text-white px-5 py-3 absolute w-full left-0 animate__animated animate__fadeInDown shadow-2xl border-t border-white/10">
      <ul class="flex flex-col space-y-2.5 font-medium text-sm">
        <li><a href="/#hero" class="block py-1 hover:text-accent">Home</a></li>
        <li><a href="/pages/pengurus" class="block py-1 hover:text-accent">Pengurus</a></li>
        <li><a href="/pages/divisi" class="block py-1 hover:text-accent">Divisi</a></li>
        <li><a href="/berita" class="block py-1 text-accent font-bold">Semua Berita</a></li>
        <li><a href="/#contact" class="block py-1 hover:text-accent">Kontak</a></li>
      </ul>
    </div>
  </nav>

  <!-- Article Header & Breadcrumbs (Refined Spacing & Typography) -->
  <header class="pt-16 pb-5 sm:pt-20 sm:pb-7 bg-slate-900 text-white relative border-b border-white/5">
    <div class="container mx-auto px-4 sm:px-6 max-w-4xl">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-300 mb-3.5" aria-label="Breadcrumb">
        <a href="/" class="text-slate-300 hover:text-white transition-colors">Home</a>
        <span class="text-slate-500 text-[10px]">/</span>
        <a href="/berita" class="text-slate-300 hover:text-white transition-colors">Berita</a>
        <span class="text-slate-500 text-[10px]">/</span>
        <span class="text-accent font-semibold truncate max-w-[180px] sm:max-w-none">{post.category_name || post.category}</span>
      </nav>

      <!-- Category Badge -->
      <div class="mb-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-0.5 bg-accent text-slate-950 font-bold text-[11px] sm:text-xs uppercase tracking-wider rounded-md shadow-xs">
          <i class={`fas ${getCategoryIcon(post.category)} text-[10px]`}></i>
          {post.category_name || post.category}
        </span>
      </div>

      <!-- Title (Balanced scale & line-height) -->
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white leading-[1.22] sm:leading-[1.25] tracking-tight mb-4">
        {post.title}
      </h1>

      <!-- Meta Bar (Compact & Single-row on Desktop) -->
      <div class="pt-3.5 border-t border-white/10 text-xs sm:text-sm text-slate-300 flex flex-wrap items-center gap-y-1.5 gap-x-2">
        <span class="font-semibold text-white flex items-center gap-1.5">
          <i class="fas fa-user-pen text-accent text-xs"></i> {post.author_name}
        </span>
        <span class="text-white/40">·</span>
        <time datetime={post.published_at || post.created_at} class="text-slate-300">
          {formatDateIndo(post.published_at || post.created_at)}
        </time>
        <span class="text-white/40">·</span>
        <span class="text-slate-300 flex items-center gap-1" title="Estimasi waktu baca">
          <i class="far fa-clock text-accent text-xs"></i> {readingTime} menit baca
        </span>
        <span class="text-white/40">·</span>
        <span class="text-slate-300 flex items-center gap-1" id="postViewsDisplay" title="Jumlah pembaca">
          <i class="far fa-eye text-accent text-xs"></i> <span id="postViewsCount">{post.views || 0}</span> dibaca
        </span>
      </div>
    </div>
  </header>

  <!-- Article Main Content -->
  <main class="py-6 sm:py-8">
    <div class="container mx-auto px-4 sm:px-6 max-w-4xl">

      <!-- Main Thumbnail (border-radius: 18px, shadow-md, subtle credit) -->
      {post.thumbnail && (
        <div class="mb-6 sm:mb-8 rounded-[18px] overflow-hidden shadow-md border border-slate-200/80 aspect-[16/9] bg-slate-900 relative">
          <img
            src={post.thumbnail}
            alt={post.title}
            class="w-full h-full object-cover"
            loading="eager"
            decoding="async"
          />
          <span class="absolute bottom-2.5 right-2.5 px-2 py-0.5 rounded bg-black/40 backdrop-blur-xs text-white/60 text-[10px] tracking-wide pointer-events-none select-none">
            himtekk.com
          </span>
        </div>
      )}

      <!-- Body Article (Clean News Editorial Style) -->
      <article class="bg-white rounded-[16px] p-6 sm:p-8 md:p-10 border border-slate-200/80 shadow-xs mb-8">
        <div class="article-content" set:html={safeContent} />

        <!-- Tags -->
        {tags.length > 0 && (
          <div class="mt-8 pt-5 border-t border-slate-100 flex flex-wrap items-center gap-2">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider mr-1">
              <i class="fas fa-tags"></i> Topik:
            </span>
            {tags.map((tag) => (
              <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs font-medium rounded-md hover:bg-slate-200 transition-colors">
                #{tag}
              </span>
            ))}
          </div>
        )}

        <!-- Social Share Bar -->
        <div class="mt-6 pt-5 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <span class="text-xs sm:text-sm font-bold text-slate-700 flex items-center gap-2">
            <i class="fas fa-share-nodes text-primary"></i> Bagikan Berita:
          </span>

          <div class="flex items-center gap-2 flex-wrap">
            <a
              href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`${post.title} - Baca di: ${postUrl}`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-8 h-8 rounded-lg bg-emerald-500 text-white flex items-center justify-center hover:opacity-90 transition-opacity shadow-xs"
              title="Bagikan ke WhatsApp"
            >
              <i class="fab fa-whatsapp text-sm"></i>
            </a>

            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(postUrl)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-8 h-8 rounded-lg bg-slate-900 text-white flex items-center justify-center hover:opacity-90 transition-opacity shadow-xs"
              title="Bagikan ke X (Twitter)"
            >
              <i class="fab fa-x-twitter text-sm"></i>
            </a>

            <a
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-8 h-8 rounded-lg bg-blue-700 text-white flex items-center justify-center hover:opacity-90 transition-opacity shadow-xs"
              title="Bagikan ke LinkedIn"
            >
              <i class="fab fa-linkedin-in text-sm"></i>
            </a>

            <a
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(postUrl)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center hover:opacity-90 transition-opacity shadow-xs"
              title="Bagikan ke Facebook"
            >
              <i class="fab fa-facebook-f text-sm"></i>
            </a>

            <button
              type="button"
              id="copyPostLinkBtn"
              class="px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold flex items-center gap-1.5 transition-colors"
              title="Salin Tautan Berita"
            >
              <i class="far fa-copy"></i> Salin Link
            </button>
          </div>
        </div>
      </article>

      <!-- Author Box (Compact Editorial Signature) -->
      <div class="bg-slate-900 rounded-[14px] p-5 sm:p-6 text-white border border-slate-800 shadow-sm flex flex-col sm:flex-row items-center sm:items-start gap-4 mb-10">
        <div class="w-12 h-12 rounded-xl bg-accent text-slate-950 flex items-center justify-center text-xl font-bold shrink-0 shadow">
          <i class="fas fa-shield-halved"></i>
        </div>
        <div class="text-center sm:text-left">
          <div class="inline-block px-2 py-0.5 rounded bg-accent/20 border border-accent/40 text-accent text-[10px] font-bold uppercase tracking-wider mb-1.5">
            Redaksi Resmi
          </div>
          <h3 class="text-lg font-bold text-white mb-1">{post.author_name}</h3>
          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
            Himpunan Mahasiswa Teknik Komputer (HIMTEKK) Universitas Amikom Yogyakarta berfokus pada pengembangan riset Cyber Security, Internet of Things (IoT), dan kontribusi kemajuan teknologi mahasiswa.
          </p>
        </div>
      </div>

      <!-- Related News Section -->
      {relatedPosts.length > 0 && (
        <section>
          <div class="flex items-center justify-between mb-5">
            <h3 class="text-lg sm:text-xl font-bold text-primary">Berita Terkait</h3>
            <a href="/berita" class="text-xs sm:text-sm font-semibold text-accent hover:underline flex items-center gap-1">
              Lihat Semua <i class="fas fa-arrow-right text-[10px]"></i>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            {relatedPosts.map((rel) => (
              <a
                href={`/berita/${rel.slug}`}
                class="bg-white rounded-[12px] border border-slate-200 overflow-hidden shadow-xs hover:shadow-md transition-all duration-200 group flex flex-col"
              >
                <div class="aspect-[16/9] overflow-hidden bg-slate-100 relative">
                  <img
                    src={rel.thumbnail || '/assets/img/placeholder.webp'}
                    alt={rel.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                  <span class="absolute top-2 left-2 px-2 py-0.5 rounded bg-primary text-white text-[10px] font-bold uppercase">
                    {rel.category_name || rel.category}
                  </span>
                </div>
                <div class="p-3.5 flex flex-col flex-grow justify-between">
                  <h4 class="font-bold text-sm text-slate-800 group-hover:text-primary transition-colors line-clamp-2 mb-2 leading-snug">
                    {rel.title}
                  </h4>
                  <div class="text-[11px] text-slate-400 flex items-center justify-between pt-2 border-t border-slate-100">
                    <span>{formatDateIndo(rel.published_at || rel.created_at)}</span>
                    <span><i class="far fa-eye"></i> {rel.views || 0}</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </main>

  <!-- Footer -->
  <footer class="pt-20 pb-10 bg-slate-900 text-white border-t border-white/5">
    <div class="container mx-auto px-6 text-center">
      <div class="flex items-center justify-center gap-3 mb-4">
        <img src="/assets/img/logo.webp" alt="Logo HIMTEKK" class="h-10 w-auto" width="40" height="40" loading="lazy">
        <span class="text-xl font-bold"><span class="text-accent">HIM</span>TEKK</span>
      </div>
      <p class="text-slate-400 text-xs sm:text-sm mb-6 max-w-md mx-auto">
        Portal Berita & Publikasi Resmi Himpunan Mahasiswa Teknik Komputer Universitas Amikom Yogyakarta.
      </p>
      <div class="flex justify-center gap-6 text-xs text-slate-500">
        <a href="/" class="hover:text-accent">Beranda</a>
        <a href="/berita" class="hover:text-accent">Daftar Berita</a>
        <a href="/pages/privacy" class="hover:text-accent">Privacy Policy</a>
        <a href="/pages/terms" class="hover:text-accent">Terms</a>
      </div>
      <p class="text-slate-600 text-xs mt-6">&copy; 2026 HIMTEKK Amikom. All rights reserved.</p>
    </div>
  </footer>

  <Fragment slot="scripts">
    <script is:inline src="/js/berita.js"></script>
    <script is:inline define:vars={{ postSlug: post.slug }}>
      document.addEventListener('DOMContentLoaded', () => {
        // 1. Reading progress bar
        const progressBar = document.getElementById('readingProgressBar');
        window.addEventListener('scroll', () => {
          const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          if (docHeight > 0) {
            const scrolled = (window.scrollY / docHeight) * 100;
            if (progressBar) progressBar.style.width = `${scrolled}%`;
          }
        }, { passive: true });

        // 2. Increment view counter via client-side gateway
        if (typeof BeritaAPI !== 'undefined' && postSlug) {
          BeritaAPI.incrementView(postSlug).then((res) => {
            if (res && res.success && res.data && typeof res.data.views === 'number') {
              const el = document.getElementById('postViewsCount');
              if (el) el.textContent = res.data.views;
            }
          }).catch(() => {});
        }

        // 3. Salin link tombol
        const copyBtn = document.getElementById('copyPostLinkBtn');
        if (copyBtn) {
          copyBtn.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(window.location.href);
              if (typeof showBeritaToast === 'function') {
                showBeritaToast('success', 'Tautan Berhasil Disalin', 'Tautan artikel telah tersimpan di clipboard Anda.');
              } else {
                alert('Tautan artikel telah disalin.');
              }
            } catch {
              alert('Gagal menyalin tautan.');
            }
          });
        }
      });
    </script>
  </Fragment>
</Layout>
)}
