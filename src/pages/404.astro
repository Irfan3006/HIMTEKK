---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="404 - Halaman Tidak Ditemukan | HIMTEKK"
  description="Ups! Halaman yang Anda cari tidak ditemukan di website HIMTEKK Amikom Yogyakarta."
  robots="noindex, follow"
  bodyClass="min-h-screen flex items-center justify-center overflow-hidden font-sans"
  sweetalert={false}
>
<Fragment slot="head">
<style is:inline>
        body {
            background-color: #F8FAFC;
        }

        .error-code {
            font-size: clamp(5rem, 18vw, 11rem);
            line-height: 1;
            color: #00406E;
            font-weight: 800;
            text-shadow: 0 10px 30px rgba(0, 64, 110, 0.1);
        }

        .floating {
            animation: floating 3s ease-in-out infinite;
        }

        @keyframes floating {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }

        .blob {
            position: absolute;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(0,64,110,0.05) 0%, transparent 70%);
            border-radius: 50%;
            z-index: -1;
        }
    </style>
</Fragment>

    
    <!-- Decorative Elements -->
    <div class="blob top-[-250px] right-[-250px] animate__animated animate__pulse animate__infinite"></div>
    <div class="blob bottom-[-250px] left-[-250px] animate__animated animate__pulse animate__infinite animate__delay-1s"></div>

    <div class="container mx-auto px-4 sm:px-6 text-center py-12">
        <div class="relative flex items-center justify-center mb-6 sm:mb-8 gap-3 sm:gap-6 md:gap-8">
            <h1 class="error-code font-bold select-none leading-none">4</h1>
            <div class="floating">
                <img src="/assets/img/logo.webp" alt="Logo HIMTEKK" class="w-20 h-20 sm:w-28 sm:h-28 md:w-40 md:h-40 drop-shadow-[0_20px_50px_rgba(219,184,101,0.3)]" width="160" height="160" fetchpriority="high">
            </div>
            <h1 class="error-code font-bold select-none leading-none">4</h1>
        </div>

        <div class="max-w-2xl mx-auto animate__animated animate__fadeInUp">
            <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-primary mb-3 sm:mb-4">Ups! Halaman Tidak Ditemukan</h2>
            <p class="text-slate-600 text-base sm:text-lg mb-8 sm:mb-10 leading-relaxed px-2">
                Maaf, sepertinya Anda tersesat. Halaman yang Anda cari mungkin telah pindah, dihapus, atau memang tidak pernah ada.
            </p>

            <div class="flex flex-col sm:flex-row gap-3.5 sm:gap-4 justify-center max-w-md mx-auto sm:max-w-none">
                <a href="/" class="bg-primary hover:bg-primary/90 text-white font-bold py-3.5 sm:py-4 px-8 sm:px-10 rounded-full transition-all transform hover:scale-105 shadow-xl flex items-center justify-center gap-3 group">
                    <i class="fas fa-home group-hover:-translate-y-1 transition-transform"></i>
                    Kembali ke Beranda
                </a>
                <a href="/#contact" class="bg-white border-2 border-primary/10 hover:border-primary/30 text-primary font-bold py-3.5 sm:py-4 px-8 sm:px-10 rounded-full transition-all flex items-center justify-center gap-3">
                    <i class="fas fa-envelope"></i>
                    Laporkan Masalah
                </a>
            </div>
        </div>

        <div class="mt-16 text-slate-400 text-sm animate__animated animate__fadeIn animate__delay-2s">
            <p>&copy; 2026 HIMTEKK Universitas Amikom Yogyakarta</p>
        </div>
    </div>

    <!-- Scripts -->

<Fragment slot="scripts">
<script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof AOS !== 'undefined') {
                AOS.init({
                    duration: 1000,
                    once: true
                });
            }
        });
    </script>
</Fragment>
</Layout>
