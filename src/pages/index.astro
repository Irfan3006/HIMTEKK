---
import Layout from '../layouts/Layout.astro';
import { getBeritaIndex, type BeritaPost } from '../lib/berita-api';
import { formatDateIndo, getCategoryIcon } from '../lib/berita-config';

// Ambil berita terbaru untuk beranda
let latestPosts: BeritaPost[] = [];
try {
  const { posts } = await getBeritaIndex();
  const published = (posts || []).filter((p) => p.status === 'published' || p.status === undefined);
  latestPosts = published.slice(0, 3);
} catch (err) {
  console.error('Error fetching berita for homepage:', err);
  latestPosts = [];
}
---
<Layout
  title="HIMTEKK - Himpunan Mahasiswa Teknik Komputer"
  description="HIMTEKK Amikom Yogyakarta adalah organisasi mahasiswa Teknik Komputer yang fokus pada Cyber Security dan IoT. Gabung, belajar, dan kembangkan skill teknologi masa depan bersama kami!"
  keywords="HIMTEKK, HIMTEKK Amikom, Himpunan Mahasiswa Teknik Komputer Amikom, Organisasi Teknik Komputer Yogyakarta, Komunitas Cyber Security Jogja, Belajar Cyber Security Amikom, Komunitas IoT Yogyakarta, HIMTEKK Universitas Amikom"
  author="HIMTEKK Amikom"
  robots="index, follow"
  canonical="https://himtekk.com/"
  ogTitle="HIMTEKK - Himpunan Mahasiswa Teknik Komputer Amikom"
  ogDescription="Website resmi HIMTEKK Universitas Amikom Yogyakarta. Fokus pada Cyber Security, IoT, dan pengembangan inovasi mahasiswa."
  bodyClass="text-slate-800 overflow-x-hidden"
  preloadHero
>
<Fragment slot="head">
<script type="application/ld+json" is:inline>
    {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "HIMTEKK",
    "alternateName": "HIMTEKK Amikom Yogyakarta",
    "url": "https://himtekk.com/"
    }
    </script>
<script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "HIMTEKK Amikom Yogyakarta",
      "alternateName": "Himpunan Mahasiswa Teknik Komputer Universitas Amikom Yogyakarta",
      "url": "https://himtekk.com/",
      "logo": "https://himtekk.com/assets/img/logo.webp",
      "areaServed": "Yogyakarta",
      "foundingDate": "2017",
      "sameAs": [
        "https://www.instagram.com/himtekk_amikom/",
        "https://www.linkedin.com/company/himtekk-amikom/"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "himtekk@amikom.ac.id",
        "contactType": "technical support"
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Jl. Ring Road Utara, Condongcatur, Sleman",
        "addressLocality": "Yogyakarta",
        "addressRegion": "DIY",
        "postalCode": "55283",
        "addressCountry": "ID"
      }
    }
    </script>
</Fragment>

    <!-- Navbar -->
    <nav id="navbar" class="fixed w-full z-50 transition-all duration-300 py-3 sm:py-4">
        <div class="container mx-auto px-6 flex justify-between items-center">
            <a href="#" class="flex items-center gap-3 group">
                <img src="assets/img/logo.webp" alt="Logo HIMTEKK" class="nav-logo-img transition-transform group-hover:rotate-12" width="40" height="40" decoding="async">
                <span class="text-2xl font-bold text-white"><span class="text-accent">HIM</span>TEKK</span>
            </a>
            
            <!-- Mobile Menu Button -->
            <button id="mobile-menu-btn" class="md:hidden text-white" aria-label="Menu Navigasi">
                <i class="fas fa-bars text-2xl"></i>
            </button>
            
            <!-- Desktop Links -->
            <ul class="hidden md:flex space-x-8 text-white font-medium">
                <li><a href="#hero" class="nav-link active">Home</a></li>
                <li><a href="#about" class="nav-link">Tentang</a></li>
                <li><a href="#fokus" class="nav-link">Fokus</a></li>
                <li><a href="/pages/pengurus" class="nav-link">Pengurus</a></li>
                <li><a href="/pages/divisi" class="nav-link">Divisi</a></li>
                <li><a href="#kegiatan" class="nav-link">Kegiatan</a></li>
                <li><a href="#berita" class="nav-link">Berita</a></li>
                <li><a href="#contact" class="nav-link">Kontak</a></li>
            </ul>
        </div>
        
        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden md:hidden bg-primary text-white px-6 py-4 absolute w-full left-0 animate__animated animate__fadeInDown">
            <ul class="flex flex-col space-y-4">
                <li><a href="#hero" class="block">Home</a></li>
                <li><a href="#about" class="block">Tentang</a></li>
                <li><a href="#fokus" class="block">Fokus</a></li>
                <li><a href="/pages/pengurus" class="block">Pengurus</a></li>
                <li><a href="/pages/divisi" class="block text-accent font-semibold">Divisi & Rekrutmen</a></li>
                <li><a href="#kegiatan" class="block">Kegiatan</a></li>
                <li><a href="#berita" class="block">Berita</a></li>
                <li><a href="#contact" class="block">Kontak</a></li>
            </ul>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="hero" class="relative h-screen flex items-center justify-center bg-hero-pattern bg-cover bg-center overflow-hidden">
        <div class="container mx-auto px-6 text-center z-10">
            <div class="mb-8 animate__animated animate__zoomIn">
                <img src="assets/img/logo.webp" alt="HIMTEKK Logo" class="w-32 h-32 mx-auto drop-shadow-[0_0_15px_rgba(219,184,101,0.5)]" width="128" height="128" fetchpriority="high">
            </div>
            <h1 class="text-5xl md:text-7xl font-bold text-white mb-4 animate__animated animate__fadeInUp">
                HIMTEKK
            </h1>
            <p class="text-xl md:text-2xl text-secondary opacity-90 mb-8 animate__animated animate__fadeInUp animate__delay-1s">
                Himpunan Mahasiswa Teknik Komputer
            </p>
            <p class="text-lg text-secondary max-w-2xl mx-auto mb-10 opacity-80 animate__animated animate__fadeInUp animate__delay-1s">
                Wadah aspirasi dan pengembangan diri mahasiswa Teknik Komputer Universitas Amikom Yogyakarta menuju masa depan teknologi yang inovatif.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center animate__animated animate__fadeInUp animate__delay-2s">
                <a href="#about" class="w-full sm:w-auto max-w-xs text-center bg-accent hover:bg-yellow-600 text-primary font-bold py-3.5 sm:py-4 px-8 rounded-full transition-all duration-300 transform hover:scale-105 shadow-md">
                    Pelajari Lebih Lanjut
                </a>
                <a href="/pages/divisi" id="btn-gabung" class="w-full sm:w-auto max-w-xs text-center glass text-white font-bold py-3.5 sm:py-4 px-8 rounded-full hover:bg-white hover:text-primary transition-all duration-300">
                    Gabung Sekarang
                </a>
            </div>
        </div>
        
        <!-- Decorative elements -->
        <div class="absolute bottom-7 left-1/2 -translate-x-1/2 animate-bounce">
            <a href="#about" class="text-white text-2xl"><i class="fas fa-chevron-down"></i></a>
        </div>
    </section>

    <!-- Tentang HIMTEKK -->
    <section id="about" class="py-24 bg-white overflow-hidden">
        <div class="container mx-auto px-6">
            <div class="flex flex-col md:flex-row items-center gap-16">
                <div class="md:w-1/2" data-aos="fade-right">
                    <h2 class="text-accent font-bold uppercase tracking-widest mb-2">Tentang Kami</h2>
                    <h3 class="text-4xl font-bold text-primary mb-6">Himpunan Mahasiswa Teknik Komputer</h3>
                    <p class="text-lg leading-relaxed mb-6 text-slate-600">
                        HIMTEKK (Himpunan Mahasiswa Teknik Komputer) adalah organisasi resmi di Universitas Amikom Yogyakarta yang menjadi rumah bagi mahasiswa program studi Teknik Komputer. Berdiri sejak tahun 2017, kami berdedikasi untuk menciptakan lingkungan yang mendukung pertumbuhan akademik dan kreativitas.
                    </p>
                    <div class="flex items-start gap-4 mb-6">
                        <div class="bg-primary/10 p-3 rounded-lg text-primary">
                            <i class="fas fa-link text-xl"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-primary">Jembatan Mahasiswa & Prodi</h4>
                            <p class="text-slate-600">Berperan sebagai penghubung komunikasi antara mahasiswa dan program studi.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div class="bg-primary/10 p-3 rounded-lg text-primary">
                            <i class="fas fa-calendar-alt text-xl"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-primary">Aktif & Berkelanjutan</h4>
                            <p class="text-slate-600">Terus bergerak menciptakan program kerja yang relevan dengan perkembangan teknologi.</p>
                        </div>
                    </div>
                </div>
                <div class="md:w-1/2 grid grid-cols-2 gap-3 sm:gap-4" data-aos="fade-left">
                    <div class="bg-primary p-6 sm:p-10 rounded-2xl text-white text-center flex flex-col justify-center">
                        <span class="text-3xl sm:text-4xl font-bold mb-2">9+</span>
                        <span class="opacity-80 text-sm sm:text-base">Tahun Berdiri</span>
                    </div>
                    <div class="bg-accent p-6 sm:p-10 rounded-2xl text-primary text-center flex flex-col justify-center">
                        <span class="text-3xl sm:text-4xl font-bold mb-2">2</span>
                        <span class="opacity-80 font-bold text-sm sm:text-base">Bidang Fokus</span>
                    </div>
                    <div class="col-span-2 bg-slate-100 p-6 sm:p-8 rounded-2xl text-primary">
                        <p class="italic text-base sm:text-lg text-center">"Empowering the next generation of computer engineers."</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Bidang Fokus -->
    <section id="fokus" class="py-24 bg-slate-50 overflow-hidden">
        <div class="container mx-auto px-6">
            <div class="text-center mb-16">
                <h2 class="text-accent font-bold uppercase tracking-widest mb-2" data-aos="fade-up">Bidang Fokus</h2>
                <h3 class="text-4xl font-bold text-primary" data-aos="fade-up" data-aos-delay="100">Spesialisasi Kami</h3>
            </div>
            
            <div class="grid md:grid-cols-2 gap-8 md:gap-10">
                <!-- Cyber Security -->
                <div class="bg-white p-6 sm:p-8 md:p-10 rounded-3xl card-hover border border-slate-100" data-aos="zoom-in" data-aos-delay="200">
                    <div class="w-16 h-16 sm:w-20 sm:h-20 bg-primary/10 rounded-2xl flex items-center justify-center text-primary text-3xl sm:text-4xl mb-6 sm:mb-8">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <h4 class="text-2xl font-bold text-primary mb-4">Cyber Security</h4>
                    <p class="text-slate-600 leading-relaxed">
                        Mempelajari teknik perlindungan sistem, jaringan, dan program dari serangan digital. Fokus kami meliputi pengamanan infrastruktur IT dan penanganan ancaman siber.
                    </p>
                    <ul class="mt-6 space-y-3">
                        <li class="flex items-center gap-3 text-slate-700">
                            <i class="fas fa-check-circle text-accent"></i> Ethical Hacking
                        </li>
                        <li class="flex items-center gap-3 text-slate-700">
                            <i class="fas fa-check-circle text-accent"></i> Network Security
                        </li>
                        <li class="flex items-center gap-3 text-slate-700">
                            <i class="fas fa-check-circle text-accent"></i> Cryptography
                        </li>
                    </ul>
                </div>
                
                <!-- IoT -->
                <div class="bg-white p-6 sm:p-8 md:p-10 rounded-3xl card-hover border border-slate-100" data-aos="zoom-in" data-aos-delay="400">
                    <div class="w-16 h-16 sm:w-20 sm:h-20 bg-accent/10 rounded-2xl flex items-center justify-center text-accent text-3xl sm:text-4xl mb-6 sm:mb-8">
                        <i class="fas fa-microchip"></i>
                    </div>
                    <h4 class="text-2xl font-bold text-primary mb-4">Internet of Things (IoT)</h4>
                    <p class="text-slate-600 leading-relaxed">
                        Menjelajahi dunia perangkat keras yang terhubung. Kami fokus pada pengembangan sistem cerdas, otomasi, dan integrasi sensor dengan platform cloud.
                    </p>
                    <ul class="mt-6 space-y-3">
                        <li class="flex items-center gap-3 text-slate-700">
                            <i class="fas fa-check-circle text-accent"></i> Embedded Systems
                        </li>
                        <li class="flex items-center gap-3 text-slate-700">
                            <i class="fas fa-check-circle text-accent"></i> Smart Home Tech
                        </li>
                        <li class="flex items-center gap-3 text-slate-700">
                            <i class="fas fa-check-circle text-accent"></i> Sensor Networks
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Struktur Pengurus -->
    <section id="pengurus" class="py-24 bg-white overflow-hidden">
        <div class="container mx-auto px-6">
            <div class="text-center mb-16">
                <h2 class="text-accent font-bold uppercase tracking-widest mb-2" data-aos="fade-up">Struktur Organisasi</h2>
                <h3 class="text-4xl font-bold text-primary" data-aos="fade-up" data-aos-delay="100">Pengurus Inti</h3>
            </div>
            
            <div class="grid md:grid-cols-3 gap-10">
                <!-- Ketua -->
                <div class="text-center group" data-aos="fade-up" data-aos-delay="200">
                    <div class="relative overflow-hidden rounded-2xl mb-6 aspect-[3/4]">
                        <img src="assets/img/pengurus/ketua.webp" alt="Ketua HIMTEKK" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                        <div class="absolute inset-0 bg-primary/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                            <a href="https://www.instagram.com/ihsnulfikrii_/" target="_blank" class="w-12 h-12 bg-white rounded-full flex items-center justify-center text-primary text-xl hover:bg-accent hover:text-white transition-colors">
                                <i class="fab fa-instagram"></i>
                            </a>
                        </div>
                    </div>
                    <h4 class="text-2xl font-bold text-primary">Ketua Umum</h4>
                    <p class="text-accent font-semibold">Ihsanul Fikri</p>
                </div>
                
                <!-- Sekjend -->
                <div class="text-center group" data-aos="fade-up" data-aos-delay="300">
                    <div class="relative overflow-hidden rounded-2xl mb-6 aspect-[3/4]">
                        <img src="assets/img/pengurus/sekjend.webp" alt="Sekjend HIMTEKK" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                        <div class="absolute inset-0 bg-primary/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                            <a href="https://www.instagram.com/jaysufutra/" target="_blank" class="w-12 h-12 bg-white rounded-full flex items-center justify-center text-primary text-xl hover:bg-accent hover:text-white transition-colors">
                                <i class="fab fa-instagram"></i>
                            </a>
                        </div>
                    </div>
                    <h4 class="text-2xl font-bold text-primary">Sekjend</h4>
                    <p class="text-accent font-semibold">Sufutra Jaya Inathasalen</p>
                </div>
                
                <!-- Sekretaris -->
                <div class="text-center group" data-aos="fade-up" data-aos-delay="400">
                    <div class="relative overflow-hidden rounded-2xl mb-6 aspect-[3/4]">
                        <img src="assets/img/pengurus/sekretaris1.webp" alt="Sekretaris HIMTEKK" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                        <div class="absolute inset-0 bg-primary/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center gap-3">
                            <a href="https://www.instagram.com/irfann_404/" target="_blank" class="w-10 h-10 bg-white rounded-full flex items-center justify-center text-primary text-lg hover:bg-accent hover:text-white transition-colors" title="Instagram">
                                <i class="fab fa-instagram"></i>
                            </a>
                            <a href="https://www.linkedin.com/in/irfan-syarifudin" target="_blank" class="w-10 h-10 bg-white rounded-full flex items-center justify-center text-primary text-lg hover:bg-accent hover:text-white transition-colors" title="LinkedIn">
                                <i class="fab fa-linkedin-in"></i>
                            </a>
                            <a href="https://github.com/Irfan3006" target="_blank" class="w-10 h-10 bg-white rounded-full flex items-center justify-center text-primary text-lg hover:bg-accent hover:text-white transition-colors" title="GitHub">
                                <i class="fab fa-github"></i>
                            </a>
                            <a href="https://irfan-syarifudin.vercel.app/" target="_blank" class="w-10 h-10 bg-white rounded-full flex items-center justify-center text-primary text-lg hover:bg-accent hover:text-white transition-colors" title="Website">
                                <i class="fas fa-globe"></i>
                            </a>
                        </div>
                    </div>
                    <h4 class="text-2xl font-bold text-primary">Sekretaris</h4>
                    <p class="text-accent font-semibold">Irfan Syarifudin</p>
                </div>
            </div>

            <!-- Tombol Lihat Semua -->
            <div class="mt-16 text-center" data-aos="fade-up">
                <a href="/pages/pengurus" class="inline-flex items-center gap-2 bg-primary hover:bg-primary/90 text-white font-bold py-4 px-10 rounded-full transition-all duration-300 transform hover:scale-105 shadow-lg group">
                    Lihat Semua Pengurus
                    <i class="fas fa-arrow-right transition-transform group-hover:translate-x-2"></i>
                </a>
            </div>
        </div>
    </section>

    <!-- Kegiatan / Program -->
    <section id="kegiatan" class="py-24 bg-slate-50 overflow-hidden">
        <div class="container mx-auto px-6">
            <div class="text-center mb-16">
                <h2 class="text-accent font-bold uppercase tracking-widest mb-2" data-aos="fade-up">Program Kerja</h2>
                <h3 class="text-4xl font-bold text-primary" data-aos="fade-up" data-aos-delay="100">Kegiatan Terbaru</h3>
            </div>
            
            <div class="grid md:grid-cols-3 gap-8">
                <!-- Program 1 -->
                <div class="bg-white rounded-2xl overflow-hidden shadow-sm card-hover" data-aos="fade-up" data-aos-delay="200">
                    <div class="h-48 bg-primary/20 flex items-center justify-center text-primary text-5xl">
                        <i class="fas fa-laptop-code"></i>
                    </div>
                    <div class="p-6">
                        <h4 class="text-xl font-bold text-primary mb-2">Workshop Cyber Security</h4>
                        <p class="text-slate-600 mb-4">Pelatihan intensif mengenai dasar-dasar keamanan jaringan dan penetration testing.</p>
                        <span class="text-accent font-bold">On-Going</span>
                    </div>
                </div>
                
                <!-- Program 2 -->
                <div class="bg-white rounded-2xl overflow-hidden shadow-sm card-hover" data-aos="fade-up" data-aos-delay="300">
                    <div class="h-48 bg-accent/20 flex items-center justify-center text-accent text-5xl">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="p-6">
                        <h4 class="text-xl font-bold text-primary mb-2">Sharing Session</h4>
                        <p class="text-slate-600 mb-4">Diskusi santai bersama alumni dan praktisi industri teknologi komputer.</p>
                        <span class="text-accent font-bold">Rutin Bulanan</span>
                    </div>
                </div>
                
                <!-- Program 3 -->
                <div class="bg-white rounded-2xl overflow-hidden shadow-sm card-hover" data-aos="fade-up" data-aos-delay="400">
                    <div class="h-48 bg-primary/20 flex items-center justify-center text-primary text-5xl">
                        <i class="fas fa-project-diagram"></i>
                    </div>
                    <div class="p-6">
                        <h4 class="text-xl font-bold text-primary mb-2">HIMTEKK Project</h4>
                        <p class="text-slate-600 mb-4">Kolaborasi pengembangan proyek IoT untuk solusi permasalahan di lingkungan kampus.</p>
                        <span class="text-accent font-bold">On-Going</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Berita & Artikel Terbaru -->
    <section id="berita" class="py-24 bg-white overflow-hidden relative">
        <!-- Ambient Decorative Glows -->
        <div class="absolute top-10 left-0 w-72 h-72 bg-primary/5 rounded-full blur-3xl pointer-events-none -ml-20"></div>
        <div class="absolute bottom-10 right-0 w-80 h-80 bg-accent/5 rounded-full blur-3xl pointer-events-none -mr-20"></div>

        <div class="container mx-auto px-6 relative z-10">
            <!-- Section Header -->
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6" data-aos="fade-up">
                <div>
                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-accent/15 border border-accent/30 text-yellow-800 text-xs font-bold uppercase tracking-wider mb-3">
                        <i class="fas fa-newspaper text-accent"></i>
                        <span>Warta & Informasi</span>
                    </div>
                    <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-primary tracking-tight">
                        Kabar & Berita <span class="text-accent underline decoration-accent/30 underline-offset-8">Terbaru</span>
                    </h2>
                    <p class="text-slate-600 text-base sm:text-lg max-w-2xl mt-4 leading-relaxed">
                        Ikuti publikasi resmi, liputan agenda kegiatan, pengumuman keorganisasian, serta artikel edukatif seputar Cyber Security dan Internet of Things dari HIMTEKK.
                    </p>
                </div>
                <div class="shrink-0 hidden md:block">
                    <a href="/berita" class="inline-flex items-center gap-2.5 bg-primary hover:bg-primary/90 text-white font-bold py-3.5 px-7 rounded-full text-sm transition-all duration-300 transform hover:scale-105 shadow-md group">
                        <span>Lihat Semua Berita</span>
                        <i class="fas fa-arrow-right text-accent transition-transform group-hover:translate-x-1"></i>
                    </a>
                </div>
            </div>

            <!-- Articles Grid -->
            {latestPosts.length > 0 ? (
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {latestPosts.map((post, idx) => (
                        <article
                            class="bg-white rounded-3xl border border-slate-200/80 shadow-sm hover:shadow-2xl transition-all duration-300 flex flex-col overflow-hidden group hover:-translate-y-2 card-hover"
                            data-aos="fade-up"
                            data-aos-delay={idx * 100}
                        >
                            <!-- Thumbnail with Category Badge & Slug Link -->
                            <a href={`/berita/${post.slug}`} class="block relative aspect-[16/10] overflow-hidden bg-slate-100" aria-label={post.title}>
                                <img
                                    src={post.thumbnail || '/assets/img/og.webp'}
                                    alt={post.title}
                                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                    loading="lazy"
                                    decoding="async"
                                    referrerpolicy="no-referrer"
                                    onerror="this.onerror=null;this.src='/assets/img/og.webp';"
                                />
                                <div class="absolute top-4 left-4">
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-primary text-white shadow-md backdrop-blur-sm border border-white/20">
                                        <i class={`fas ${getCategoryIcon(post.category)} text-accent text-[11px]`}></i>
                                        <span>{post.category_name || post.category}</span>
                                    </span>
                                </div>
                            </a>

                            <!-- Card Body -->
                            <div class="p-6 sm:p-7 flex flex-col flex-grow justify-between">
                                <div>
                                    <!-- Meta Row -->
                                    <div class="flex items-center gap-3 text-xs text-slate-400 mb-3 font-medium">
                                        <span class="flex items-center gap-1.5">
                                            <i class="far fa-calendar-alt text-accent"></i>
                                            {formatDateIndo(post.published_at || post.created_at)}
                                        </span>
                                        <span>•</span>
                                        <span class="flex items-center gap-1.5">
                                            <i class="far fa-user text-slate-400"></i>
                                            {post.author_name}
                                        </span>
                                    </div>

                                    <!-- Title with Slug Link -->
                                    <h3 class="text-xl font-bold text-slate-900 group-hover:text-primary transition-colors leading-snug mb-3">
                                        <a href={`/berita/${post.slug}`} class="line-clamp-2">
                                            {post.title}
                                        </a>
                                    </h3>

                                    <!-- Excerpt -->
                                    <p class="text-slate-600 text-sm leading-relaxed mb-6 line-clamp-3">
                                        {post.excerpt}
                                    </p>
                                </div>

                                <!-- Card Footer / Action Link -->
                                <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-sm">
                                    <span class="text-xs text-slate-400 font-medium flex items-center gap-1">
                                        <i class="far fa-eye text-slate-400"></i>
                                        <span>{post.views || 0} dibaca</span>
                                    </span>
                                    <a
                                        href={`/berita/${post.slug}`}
                                        class="font-bold text-primary group-hover:text-accent inline-flex items-center gap-2 transition-colors"
                                    >
                                        <span>Baca Artikel</span>
                                        <i class="fas fa-arrow-right text-xs transition-transform group-hover:translate-x-1"></i>
                                    </a>
                                </div>
                            </div>
                        </article>
                    ))}
                </div>
            ) : (
                <div class="text-center py-16 bg-slate-50 rounded-3xl border border-dashed border-slate-200">
                    <i class="fas fa-newspaper text-4xl text-slate-300 mb-3"></i>
                    <p class="text-slate-500 font-medium">Belum ada berita yang dipublikasikan saat ini.</p>
                </div>
            )}

            <!-- Mobile View All Button -->
            <div class="mt-10 text-center md:hidden" data-aos="fade-up">
                <a href="/berita" class="inline-flex items-center justify-center gap-2 w-full sm:w-auto bg-primary hover:bg-primary/90 text-white font-bold py-3.5 px-8 rounded-full text-sm transition-all shadow-md">
                    <span>Lihat Semua Berita & Warta</span>
                    <i class="fas fa-arrow-right text-accent"></i>
                </a>
            </div>
        </div>
    </section>

